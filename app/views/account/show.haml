.max-w-6xl.mx-auto.px-6.py-12
  - if notice.present?
    .mb-6.rounded-lg.bg-emerald-50.border.border-emerald-200.text-emerald-800.dark:text-emerald-200.px-4.py-3.text-sm{:class => "dark:bg-emerald-900/40 dark:border-emerald-700/50"}= notice
  - if alert.present?
    .mb-6.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}= alert
  .mb-8
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Мои бронирования
    %p.mt-1.text-sm.text-slate-500.dark:text-slate-400 Проверьте статус броней по номеру телефона
    %form.mt-4.flex.items-center.gap-3{:action => account_find_path, :method => "get"}
      %input.w-64.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.dark:placeholder-slate-500.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:name => "phone", :placeholder => "+7 900 000-00-00", :type => "tel", :value => @phone}
      %button.bg-indigo-600.hover:bg-indigo-700.text-white.text-sm.font-medium.px-4.py-2.rounded-lg.transition-colors Найти
  - if @guest
    .mb-6.text-sm.text-slate-500.dark:text-slate-400
      %span.font-medium.text-slate-700.dark:text-slate-300= @guest.full_name.presence || @guest.email.presence
      - if @guest.is_vip?
        %span.ml-2.inline-block.px-2.py-0.5.rounded-full.text-xs.font-medium.bg-amber-100.text-amber-700{:class => "dark:bg-amber-900/40 dark:text-amber-300"} VIP
  - if @stays.none?
    %p.text-slate-500.dark:text-slate-400.text-sm У вас пока нет броней.
  - else
    .space-y-3
      - @stays.each do |stay|
        .rounded-xl.border.border-slate-200.dark:border-slate-700.bg-white.dark:bg-slate-800.p-5
          .flex.items-start.justify-between.gap-4
            %div
              %p.font-medium.text-slate-900.dark:text-white
                Бронь №#{stay.id} — номер #{stay.room.number}
              %p.mt-1.text-sm.text-slate-500.dark:text-slate-400
                = l(stay.check_in, format: :long)
                → #{l(stay.check_out, format: :long)}
                · #{stay.nights_count} ночей · #{stay.guests_count} чел.
              - if stay.notes.present?
                %p.mt-2.text-sm.text-slate-500.dark:text-slate-400= stay.notes
            .text-right.shrink-0
              %span{:class => "inline-block px-2.5 py-1 rounded-full text-xs font-medium #{status_badge_class(stay.status)}"}
                = stay_status_label(stay.status)
              %p.mt-1.text-sm.font-medium.text-slate-900.dark:text-white= money(stay.total_price)