%div{"data-booking-form-exclude-value" => "#{@booking.id.presence || 0}", "data-booking-form-url-value" => available_admin_rooms_path, "data-controller" => "booking-form"}
  = form_with model: [:admin, @booking], class: "space-y-6" do |form|
    - if @booking.errors.any?
      .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
        %strong
          = pluralize(@booking.errors.count, "ошибка")
          \:
        = @booking.errors.full_messages.to_sentence
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
      %div
        = field_label(form, :guest_id, "Гость")
        = select_input(form, :guest_id, Guest.order(:full_name).map { |g| [g.full_name, g.id] })
        = field_errors(form, :guest_id)
        %p.mt-1.text-xs.text-slate-400.dark:text-slate-500
          Нет нужного гостя? #{link_to "Добавить нового гостя", new_admin_guest_path, class: "text-indigo-600 hover:text-indigo-800", target: "_blank"}
      .grid.grid-cols-2.gap-4
        %div
          = field_label(form, :check_in, "Дата заезда")
          = form.date_field :check_in, data: { booking_form_target: "checkIn", action: "change->booking-form#refreshRooms" },                                                                                            |
            min: Date.current, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-slate-100 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" 
          = field_errors(form, :check_in)
        %div
          = field_label(form, :check_out, "Дата выезда")
          = form.date_field :check_out, data: { booking_form_target: "checkOut", action: "change->booking-form#refreshRooms" },                                                                                                |
            min: (Date.current + 1), class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-slate-100 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" 
          = field_errors(form, :check_out)
        %div
          = field_label(form, :guests_count, "Количество гостей")
          = number_input(form, :guests_count, min: 1)
          = field_errors(form, :guests_count)
        %div
          = field_label(form, :status, "Статус")
          = select_input(form, :status, Booking.statuses.keys.map { |s| [booking_status_label(s), s] }, selected: @booking.status)
      %div
        = field_label(form, :room_id, "Номер")
        = form.select :room_id, [],                                                                                                                                             |
          { include_blank: "Выберите даты…" },                                                                                                                                  |
          data: { booking_form_target: "room" },                                                                                                                                |
          class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white dark:bg-slate-800" 
        = field_errors(form, :room_id)
      %div
        = field_label(form, :notes, "Заметки")
        = text_area(form, :notes, rows: 3, placeholder: "Пожелания, особые условия…")
    .flex.items-center.gap-3
      = form.submit @booking.new_record? ? "Создать бронь" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
      = link_to "Отмена", admin_bookings_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"
