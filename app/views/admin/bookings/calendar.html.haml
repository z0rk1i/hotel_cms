.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Календарь бронирований
    = link_to "+ Новая бронь", new_admin_booking_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .flex.items-center.justify-between
    .flex.items-center.gap-2
      = link_to "← Предыдущий", calendar_admin_bookings_path(month: @prev_month.strftime("%Y-%m")),                                                                                                      |
        class: "px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/40" 
      = link_to "Следующий →", calendar_admin_bookings_path(month: @next_month.strftime("%Y-%m")),                                                                                                       |
        class: "px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/40" |
    %h2.text-lg.font-semibold.text-slate-900.dark:text-white= russian_month_header(@month)
    .flex.items-center.gap-2
      .hidden.sm:flex.items-center.gap-3.text-xs.text-slate-500.dark:text-slate-400
        - Booking.statuses.keys.reject { |s| s == "cancelled" }.each do |status|
          %span.inline-flex.items-center.gap-1
            %span{:class => "w-3 h-3 rounded-sm border #{calendar_booking_class(status).split(" ").first(2).join(" ")}"}
            = booking_status_label(status)
      = link_to "Сегодня", calendar_admin_bookings_path,                            |
        class: "px-3 py-1.5 rounded-lg bg-slate-900 text-white text-sm font-medium" 
  - if @calendar.any?
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .overflow-x-auto
        %table.w-full.text-sm.border-collapse{:style => "table-layout: fixed;"}
          %thead
            %tr.bg-slate-50.text-slate-500.dark:text-slate-400{:class => "dark:bg-slate-800/60"}
              %th.px-3.py-2.font-medium.text-left.sticky.left-0.bg-slate-50.z-10{:class => "dark:bg-slate-800/60 min-w-[10rem]"} Номер
              - (1..@month.end_of_month.day).each do |day|
                - date = Date.new(@month.year, @month.month, day)
                %th{:class => "px-1 py-2 font-medium text-center min-w-9 #{date.saturday? || date.sunday? ? "bg-slate-100 dark:bg-slate-700/40" : ""}"}
                  .uppercase{:class => "text-[10px]"}= russian_day_abbr(date)
                  .text-xs.font-semibold.text-slate-700.dark:text-slate-200= day
          %tbody.divide-y.divide-slate-100.dark:divide-slate-800
            - @calendar.each do |row|
              - room = row[:room]
              %tr
                %td.px-3.py-2.text-slate-700.dark:text-slate-200.font-medium.sticky.left-0.bg-white.dark:bg-slate-800.z-10{:class => "min-w-[10rem]"}
                  = room.number
                  — #{room.category.name}
                - day = 0
                - while day < @month.end_of_month.day
                  - slot = row[:bookings].find { |b| b[:col_start] == day }
                  - if slot
                    %td{:class => "p-0.5 #{slot[:col_span] > 1 ? "min-w-9" : ""}", :colspan => "#{slot[:col_span]}"}
                      = link_to admin_booking_path(slot[:booking]), class: "block h-8 px-1 py-1 rounded border text-[11px] leading-tight truncate hover:brightness-95 transition #{calendar_booking_class(slot[:booking].status)}" do
                        %span.font-medium.truncate.block= slot[:booking].guest.full_name
                        - if slot[:col_span] >= 3
                          %span.truncate.block
                            = slot[:col_span]
                            ноч.
                    - day += slot[:col_span]
                  - else
                    - date = Date.new(@month.year, @month.month, day + 1)
                    %td{:class => "p-0 #{date.saturday? || date.sunday? ? "bg-slate-100 dark:bg-slate-700/40" : ""} min-w-9"}
                    - day += 1
  - else
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-10.text-center.text-sm.text-slate-400.dark:text-slate-500
      Нет номеров. #{link_to "Добавить номер", new_admin_room_path, class: "text-indigo-600 hover:text-indigo-800"}
