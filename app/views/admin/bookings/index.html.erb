<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Бронирования</h1>
    <%= link_to "+ Новая бронь", new_admin_booking_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Все", admin_bookings_path, class: filter_link_class(params[:status].blank?) %>
    <% Booking.statuses.each_key do |status| %>
      <%= link_to booking_status_label(status), admin_bookings_path(status: status), class: filter_link_class(params[:status] == status) %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Гость</th>
          <th class="px-5 py-3 font-medium">Номер</th>
          <th class="px-5 py-3 font-medium">Даты</th>
          <th class="px-5 py-3 font-medium">Ночей</th>
          <th class="px-5 py-3 font-medium">Сумма</th>
          <th class="px-5 py-3 font-medium">Статус</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @bookings.each do |booking| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= booking.guest.full_name %></td>
            <td class="px-5 py-3 text-slate-600"><%= booking.room.label %></td>
            <td class="px-5 py-3 text-slate-600 whitespace-nowrap">
              <%= l(booking.check_in) %> → <%= l(booking.check_out) %>
            </td>
            <td class="px-5 py-3 text-slate-600"><%= booking.nights %></td>
            <td class="px-5 py-3 text-slate-600"><%= money(booking.total_price) %></td>
            <td class="px-5 py-3"><%= content_tag :span, booking_status_label(booking.status), class: status_badge_class(booking.status) %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap space-x-2">
              <% if booking.pending? %>
                <%= button_to "Подтвердить", confirm_admin_booking_path(booking), method: :patch,
                    class: "text-blue-600 hover:text-blue-800 text-xs" %>
              <% end %>
              <% if booking.confirmed? %>
                <%= button_to "Заселить", check_in_admin_booking_path(booking), method: :patch,
                    class: "text-emerald-600 hover:text-emerald-800 text-xs" %>
              <% end %>
              <% if booking.checked_in? %>
                <%= button_to "Выселить", check_out_admin_booking_path(booking), method: :patch,
                    class: "text-amber-600 hover:text-amber-800 text-xs" %>
              <% end %>
              <% unless booking.checked_out? || booking.cancelled? %>
                <%= button_to "Отменить", cancel_admin_booking_path(booking), method: :patch,
                    data: { turbo_confirm: "Отменить бронь?" },
                    class: "text-red-500 hover:text-red-700 text-xs" %>
              <% end %>
              <%= link_to "Изменить", edit_admin_booking_path(booking), class: "text-indigo-600 hover:text-indigo-800 text-xs" %>
            </td>
          </tr>
        <% end %>
        <% if @bookings.empty? %>
          <tr><td colspan="7" class="px-5 py-8 text-center text-slate-400">Броней не найдено</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "layouts/admin/pagination", pagy: @pagy if @pagy %>
</div>
