<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Бронь №<%= @booking.id %></h1>
    <%= link_to "← К списку", admin_bookings_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="border-b border-slate-200 dark:border-slate-700 px-6 py-4 flex items-center justify-between">
      <h2 class="font-medium text-slate-900 dark:text-white">Детали брони</h2>
      <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium <%= status_badge_class(@booking.status) %>">
        <%= booking_status_label(@booking.status) %>
      </span>
    </div>

    <dl class="divide-y divide-slate-100 dark:divide-slate-700 text-sm">
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Гость</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.guest.full_name %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Телефон</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.guest.phone.presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Номер</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white">
          <%= link_to @booking.room.label, edit_admin_room_path(@booking.room), class: "text-indigo-600 hover:text-indigo-800" %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Даты</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white">
          <%= l(@booking.check_in, format: :long) %> → <%= l(@booking.check_out, format: :long) %> (<%= @booking.nights %> ночей)
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Гостей</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.guests_count %></dd>
      </div>
      <% if @booking.notes.present? %>
        <div class="grid grid-cols-3 gap-4 px-6 py-3">
          <dt class="text-slate-500 dark:text-slate-400">Заметки</dt>
          <dd class="col-span-2 text-slate-900 dark:text-white whitespace-pre-wrap"><%= @booking.notes %></dd>
        </div>
      <% end %>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Стоимость</dt>
        <dd class="col-span-2 font-medium text-slate-900 dark:text-white"><%= money(@booking.total_price) %></dd>
      </div>
      <% if @booking.user %>
        <div class="grid grid-cols-3 gap-4 px-6 py-3">
          <dt class="text-slate-500 dark:text-slate-400">Создал</dt>
          <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.user.full_name %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
    <h3 class="font-medium text-slate-900 dark:text-white mb-4">Действия</h3>
    <div class="flex flex-wrap items-center gap-3">
      <% if @booking.pending? %>
        <%= button_to "Подтвердить", confirm_admin_booking_path(@booking), method: :patch,
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
      <% end %>
      <% if @booking.confirmed? %>
        <%= button_to "Заселить", check_in_admin_booking_path(@booking), method: :patch,
            class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
      <% end %>
      <% if @booking.checked_in? %>
        <%= button_to "Выселить", check_out_admin_booking_path(@booking), method: :patch,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
      <% end %>
      <% unless @booking.checked_out? || @booking.cancelled? %>
        <%= button_to "Отменить", cancel_admin_booking_path(@booking), method: :patch,
            data: { turbo_confirm: "Отменить бронь?" },
            class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
      <% end %>
      <%= link_to "Изменить", edit_admin_booking_path(@booking),
          class: "bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 text-sm font-medium px-4 py-2 rounded-lg" %>
    </div>
  </div>
</div>
