.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white
      Бронь №#{@booking.id}
    = link_to "← К списку", admin_bookings_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4.flex.items-center.justify-between
      %h2.font-medium.text-slate-900.dark:text-white Детали брони
      %span{:class => "inline-block px-2.5 py-1 rounded-full text-xs font-medium #{status_badge_class(@booking.status)}"}
        = booking_status_label(@booking.status)
    %dl.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гость
        %dd.col-span-2.text-slate-900.dark:text-white= @booking.guest.full_name
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Телефон
        %dd.col-span-2.text-slate-900.dark:text-white= @booking.guest.phone.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Номер
        %dd.col-span-2.text-slate-900.dark:text-white
          = link_to @booking.room.label, edit_admin_room_path(@booking.room), class: "text-indigo-600 hover:text-indigo-800"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Даты
        %dd.col-span-2.text-slate-900.dark:text-white
          = l(@booking.check_in, format: :long)
          → #{l(@booking.check_out, format: :long)} (#{@booking.nights} ночей)
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гостей
        %dd.col-span-2.text-slate-900.dark:text-white= @booking.guests_count
      - if @booking.notes.present?
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Заметки
          %dd.col-span-2.text-slate-900.dark:text-white.whitespace-pre-wrap= @booking.notes
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Стоимость
        %dd.col-span-2.font-medium.text-slate-900.dark:text-white= money(@booking.total_price)
      - if @booking.nightly_prices.any?
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Стоимость по ночам
          %dd.col-span-2.text-slate-900.dark:text-white
            - @booking.nightly_prices.ordered.each do |entry|
              .flex.justify-between.gap-4
                %span= l(entry.date, format: :short)
                %span.text-slate-500.dark:text-slate-400= money(entry.amount)
            - if @booking.price_frozen_on
              %p.mt-2.text-xs.text-slate-400.dark:text-slate-500
                Цена зафиксирована по тарифу на #{l(@booking.price_frozen_on, format: :long)} и не меняется при изменении тарифов.
      - if @booking.user
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Создал
          %dd.col-span-2.text-slate-900.dark:text-white= @booking.user.full_name
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4.flex.items-center.justify-between
      %h2.font-medium.text-slate-900.dark:text-white Оплаты
      = link_to "+ Добавить оплату", new_admin_booking_payment_path(@booking), class: "text-sm text-indigo-600 hover:text-indigo-800"
    .px-6.py-3.flex.flex-wrap.gap-6.text-sm.border-b.border-slate-100.dark:border-slate-700
      %span.text-slate-500.dark:text-slate-400
        Оплачено:
        %strong.text-slate-900.dark:text-white= money(@booking.paid_amount)
      %span.text-slate-500.dark:text-slate-400
        Долг:
        %strong.text-slate-900.dark:text-white= money(@booking.due_amount)
      %span.text-slate-500.dark:text-slate-400
        Итого:
        %strong.text-slate-900.dark:text-white= money(@booking.total_price)
    - if @booking.payments.any?
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @booking.payments.ordered.each do |payment|
          %li.flex.items-center.justify-between.gap-4.px-6.py-3
            .flex.items-center.flex-wrap.gap-3
              %span.font-medium.text-slate-900.dark:text-white= money(payment.amount)
              %span.text-xs.text-slate-500.dark:text-slate-400
                = Payment.method_labels.fetch(payment.method, payment.method)
              %span.text-xs.text-slate-400.dark:text-slate-500= l(payment.paid_at, format: :long)
              - if payment.note.present?
                %span.text-xs.text-slate-400.dark:text-slate-500= payment.note
            = button_to "Удалить", admin_booking_payment_path(@booking, payment), method: :delete, |
              data: { turbo_confirm: "Удалить оплату?" },                                             |
              class: "text-xs text-red-500 hover:text-red-700"
    - else
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Оплат нет
  - if @booking.audit_logs.any?
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
        %h2.font-medium.text-slate-900.dark:text-white История изменений
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @booking.audit_logs.ordered.each do |log|
          %li.flex.items-center.justify-between.gap-4.px-6.py-3
            .flex.items-center.gap-2
              %span.text-slate-500.dark:text-slate-400
                = booking_status_label(log.from_status || log.to_status)
              %span.text-slate-400.dark:text-slate-600 →
              %span.font-medium.text-slate-900.dark:text-white= booking_status_label(log.to_status)
              %span.text-xs.text-slate-400.dark:text-slate-500
                = log.administrator ? log.administrator.email : "автоматически"
            %span.text-xs.text-slate-400.dark:text-slate-500= l(log.created_at, format: :short)
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6
    %h3.font-medium.text-slate-900.dark:text-white.mb-4 Действия
    .flex.flex-wrap.items-center.gap-3
      - if @booking.pending?
        = button_to "Подтвердить", confirm_admin_booking_path(@booking), method: :patch,             |
          class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" 
      - if @booking.confirmed?
        = button_to "Заселить", check_in_admin_booking_path(@booking), method: :patch,                     |
          class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg" 
      - if @booking.checked_in?
        = button_to "Выселить", check_out_admin_booking_path(@booking), method: :patch,                |
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium px-4 py-2 rounded-lg" 
      - unless @booking.checked_out? || @booking.cancelled?
        = button_to "Отменить", cancel_admin_booking_path(@booking), method: :patch,               |
          data: { turbo_confirm: "Отменить бронь?" },                                              |
          class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded-lg" 
      = link_to "Изменить", edit_admin_booking_path(@booking),                                                                                                         |
        class: "bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 text-sm font-medium px-4 py-2 rounded-lg" |
