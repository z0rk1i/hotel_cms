.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Закрытые даты
    = link_to "+ Добавить дату", new_admin_closed_date_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Дата
          %th.px-5.py-3.font-medium Причина
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @closed_dates.each do |closed_date|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= l(closed_date.date, format: :long)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= closed_date.reason.presence || "—"
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Редактировать", edit_admin_closed_date_path(closed_date), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_closed_date_path(closed_date), method: :delete, |
                data: { turbo_confirm: "Удалить дату закрытия?" },                          |
                class: "text-red-500 hover:text-red-700 ml-3"
        - if @closed_dates.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "3"} Закрытых дат пока нет
  %p.text-sm.text-slate-500.dark:text-slate-400
    На закрытые даты бронирование недоступно: публичный виджет и форма брони вернут ошибку. Администратор может вносить брони вручную.