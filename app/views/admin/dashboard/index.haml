.space-y-8
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Дашборд
    .text-sm.text-slate-500.dark:text-slate-400= l(Date.current, format: :long)
  .grid.grid-cols-2.lg:grid-cols-4.gap-4
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Загрузка отеля
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= "#{(@report.occupancy_rate * 100).round}%"
      .text-xs.text-slate-400.dark:text-slate-500.mt-1 за текущий месяц
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Номера
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= "#{@available_rooms.count} / #{@rooms.count}"
      .text-xs.text-emerald-600.mt-1 свободно из всех
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Гости сейчас
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= @occupied_rooms.count
      .text-xs.text-slate-400.dark:text-slate-500.mt-1 номеров занято
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Выручка за месяц
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@report.fact_revenue)
      .text-xs.text-slate-400.dark:text-slate-500.mt-1= "принято в этом месяце · по тарифу #{money(@report.monthly_booked_revenue)}"
      .mt-2
        = link_to "Отчёт за этот месяц →", admin_reports_path(from: Date.current.beginning_of_month, to: Date.current.end_of_month), class: "text-xs text-indigo-600 hover:text-indigo-800"
  .grid.grid-cols-1.lg:grid-cols-2.gap-6
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .px-5.py-4.border-b.border-slate-200.dark:border-slate-700.flex.items-center.justify-between
        %h2.font-medium.text-slate-800.dark:text-slate-100 Предстоящие заезды
        = link_to "Все брони", admin_stays_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
      %ul.divide-y.divide-slate-100.dark:divide-slate-800
        - @upcoming_check_ins.each do |stay|
          %li
            %a.px-5.py-3.flex.items-center.justify-between{:href => admin_stay_path(stay), :class => "hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors"}
              %div
                .font-medium.text-slate-800.dark:text-slate-100= stay.user.full_name
                .text-sm.text-slate-500.dark:text-slate-400
                  = stay.room.number
                  · #{l(stay.check_in)} → #{l(stay.check_out)}
              = content_tag :span, stay_status_label(stay.status), class: status_badge_class(stay.status)
        - if @upcoming_check_ins.empty?
          %li.px-5.py-6.text-sm.text-slate-400.dark:text-slate-500.text-center Нет предстоящих заездов
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .px-5.py-4.border-b.border-slate-200.dark:border-slate-700
        %h2.font-medium.text-slate-800.dark:text-slate-100 Номера в работе
      %ul.divide-y.divide-slate-100.dark:divide-slate-800
        - @occupied_rooms.each do |room|
          %li.px-5.py-3.flex.items-center.justify-between
            %div
              .font-medium.text-slate-800.dark:text-slate-100
                = room.number
                · #{room.category}
              .text-sm.text-slate-500.dark:text-slate-400
                - stay = room.stays.checked_in.overlapping_period(Date.current, Date.current + 1).first
                - if stay
                  = stay.user.full_name
                  · до #{l(stay.check_out)}
            %span.text-sm.text-slate-400.dark:text-slate-500 Занят
        - if @occupied_rooms.empty?
          %li.px-5.py-6.text-sm.text-slate-400.dark:text-slate-500.text-center Сейчас все номера свободны
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .px-5.py-4.border-b.border-slate-200.dark:border-slate-700.flex.items-center.justify-between
      %h2.font-medium.text-slate-800.dark:text-slate-100 Последние брони
      = link_to "Все брони", admin_stays_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
    %ul.divide-y.divide-slate-100.dark:divide-slate-800
      - @recent_stays.each do |stay|
        %li
          %a.px-5.py-3.flex.items-center.justify-between{:href => admin_stay_path(stay), :class => "hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors"}
            %div
              .font-medium.text-slate-800.dark:text-slate-100
                = stay.user.full_name
                — №#{stay.id}
              .text-sm.text-slate-500.dark:text-slate-400
                = stay.room.number
                · #{l(stay.check_in)} → #{l(stay.check_out)}
            %div.text-right
              = content_tag :span, stay_status_label(stay.status), class: status_badge_class(stay.status)
              %p.mt-1.text-sm.font-medium.text-slate-900.dark:text-white= money(stay.total_price)
      - if @recent_stays.empty?
        %li.px-5.py-6.text-sm.text-slate-400.dark:text-slate-500.text-center Броней пока нет