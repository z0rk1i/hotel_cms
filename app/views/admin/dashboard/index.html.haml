.space-y-8
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Дашборд
    .text-sm.text-slate-500.dark:text-slate-400= l(Date.current, format: :long)
  .grid.grid-cols-2.lg:grid-cols-4.gap-4
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Загрузка отеля
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= "#{@stats[:occupancy_rate]}%"
      .text-xs.text-slate-400.dark:text-slate-500.mt-1 за текущий месяц
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Номера
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= "#{@stats[:rooms_available]} / #{@stats[:rooms_total]}"
      .text-xs.text-emerald-600.mt-1 свободно из всех
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Гости сейчас
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= @stats[:checked_in_now].count
      .text-xs.text-slate-400.dark:text-slate-500.mt-1= "#{@stats[:rooms_occupied]} номеров занято"
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Выручка за месяц
      .text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@stats[:monthly_revenue])
      .text-xs.text-slate-400.dark:text-slate-500.mt-1 по выехавшим
  .grid.grid-cols-1.lg:grid-cols-2.gap-6
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .px-5.py-4.border-b.border-slate-200.dark:border-slate-700.flex.items-center.justify-between
        %h2.font-medium.text-slate-800.dark:text-slate-100 Предстоящие заезды
        = link_to "Все брони", admin_bookings_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
      %ul.divide-y.divide-slate-100.dark:divide-slate-800
        - @stats[:upcoming_check_ins].each do |booking|
          %li.px-5.py-3.flex.items-center.justify-between
            %div
              .font-medium.text-slate-800.dark:text-slate-100= booking.guest.full_name
              .text-sm.text-slate-500.dark:text-slate-400
                = booking.room.label
                · #{l(booking.check_in)} → #{l(booking.check_out)}
            = content_tag :span, booking_status_label(booking.status), class: status_badge_class(booking.status)
        - if @stats[:upcoming_check_ins].empty?
          %li.px-5.py-6.text-sm.text-slate-400.dark:text-slate-500.text-center Нет предстоящих заездов
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .px-5.py-4.border-b.border-slate-200.dark:border-slate-700
        %h2.font-medium.text-slate-800.dark:text-slate-100 Гости в отеле
      %ul.divide-y.divide-slate-100.dark:divide-slate-800
        - @stats[:checked_in_now].each do |booking|
          %li.px-5.py-3.flex.items-center.justify-between
            %div
              .font-medium.text-slate-800.dark:text-slate-100= booking.guest.full_name
              .text-sm.text-slate-500.dark:text-slate-400= booking.room.label
            %span.text-sm.text-slate-400.dark:text-slate-500
              до #{l(booking.check_out)}
        - if @stats[:checked_in_now].empty?
          %li.px-5.py-6.text-sm.text-slate-400.dark:text-slate-500.text-center Сейчас никто не заселён
