<%= form_with model: [:admin, @guest], class: "space-y-6" do |form| %>
  <% if @guest.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
      <strong><%= pluralize(@guest.errors.count, "ошибка") %>:</strong>
      <%= @guest.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-4">
    <div>
      <%= field_label(form, :full_name, "ФИО") %>
      <%= text_input(form, :full_name, placeholder: "Иванов Иван Иванович") %>
      <%= field_errors(form, :full_name) %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= field_label(form, :phone, "Телефон") %>
        <%= text_input(form, :phone, placeholder: "+7 (900) 000-00-00") %>
        <%= field_errors(form, :phone) %>
      </div>
      <div>
        <%= field_label(form, :email, "Email") %>
        <%= text_input(form, :email, placeholder: "guest@example.com") %>
        <%= field_errors(form, :email) %>
      </div>
      <div>
        <%= field_label(form, :passport_number, "Номер паспорта") %>
        <%= text_input(form, :passport_number, placeholder: "0000 000000") %>
        <%= field_errors(form, :passport_number) %>
      </div>
    </div>
    <div>
      <%= field_label(form, :notes, "Заметки") %>
      <%= text_area(form, :notes, rows: 3, placeholder: "Пожелания, особенности…") %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit @guest.new_record? ? "Добавить гостя" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg" %>
    <%= link_to "Отмена", admin_guests_path, class: "text-sm text-slate-600 hover:text-slate-800 px-3 py-2" %>
  </div>
<% end %>
