<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Гости</h1>
    <%= link_to "+ Добавить гостя", new_admin_guest_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <%= form_with url: admin_guests_path, method: :get, class: "flex gap-2" do %>
    <%= text_field_tag :query, params[:query], placeholder: "Поиск по имени или телефону…",
        class: "flex-1 max-w-sm rounded-lg border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
    <%= submit_tag "Найти", class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  <% end %>

  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Имя</th>
          <th class="px-5 py-3 font-medium">Телефон</th>
          <th class="px-5 py-3 font-medium">Email</th>
          <th class="px-5 py-3 font-medium">Паспорт</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @guests.each do |guest| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= guest.full_name %></td>
            <td class="px-5 py-3 text-slate-600"><%= guest.phone.presence || "—" %></td>
            <td class="px-5 py-3 text-slate-600"><%= guest.email.presence || "—" %></td>
            <td class="px-5 py-3 text-slate-600"><%= guest.passport_number.presence || "—" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Редактировать", edit_admin_guest_path(guest), class: "text-indigo-600 hover:text-indigo-800" %>
              <%= button_to "Удалить", admin_guest_path(guest), method: :delete,
                  data: { turbo_confirm: "Удалить гостя #{guest.full_name}?" },
                  class: "text-red-500 hover:text-red-700 ml-3" %>
            </td>
          </tr>
        <% end %>
        <% if @guests.empty? %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-slate-400">Гости не найдены</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "layouts/admin/pagination", pagy: @pagy if @pagy %>
</div>
