.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Гости
    .flex.items-center.gap-3
      = link_to "Экспорт CSV", admin_guests_path(format: :csv, query: params[:query]), class: "border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-medium px-4 py-2 rounded-lg"
      = link_to "+ Добавить гостя", new_admin_guest_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  = form_with url: admin_guests_path, method: :get, class: "flex gap-2" do
    = text_field_tag :query, params[:query], placeholder: "Поиск по имени или телефону…",                                                                 |
      class: "flex-1 max-w-sm rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" 
    = submit_tag "Найти", class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Имя
          %th.px-5.py-3.font-medium Телефон
          %th.px-5.py-3.font-medium Email
          %th.px-5.py-3.font-medium Паспорт
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @guests.each do |guest|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white
              = link_to guest.full_name, admin_guest_path(guest), class: "text-indigo-600 hover:text-indigo-800"
              - if guest.is_vip
                %span.text-xs.font-semibold.text-amber-800.bg-amber-100.rounded-full.px-2.py-0.5.ml-2{:class => "dark:bg-amber-900/40 dark:text-amber-200"} VIP
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= guest.phone.presence || "—"
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= guest.email.presence || "—"
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= guest.passport_number.presence || "—"
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Карточка", admin_guest_path(guest), class: "text-indigo-600 hover:text-indigo-800 mr-3"
              = link_to "Редактировать", edit_admin_guest_path(guest), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_guest_path(guest), method: :delete, |
                data: { turbo_confirm: "Удалить гостя #{guest.full_name}?" },  |
                class: "text-red-500 hover:text-red-700 ml-3"                  
        - if @guests.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "5"} Гости не найдены
  = render "layouts/admin/pagination", pagy: @pagy if @pagy
