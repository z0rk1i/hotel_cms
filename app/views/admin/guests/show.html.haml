.space-y-6
  .flex.items-center.justify-between.flex-wrap.gap-3
    %div
      %h1.text-2xl.font-semibold.text-slate-900.dark:text-white.flex.items-center.gap-2
        = @guest.full_name
        - if @guest.is_vip
          %span.text-xs.font-semibold.text-amber-800.bg-amber-100.rounded-full.px-2.py-0.5{:class => "dark:bg-amber-900/40 dark:text-amber-200"} VIP
    .flex.items-center.gap-3
      = link_to "Редактировать", edit_admin_guest_path(@guest), class: "text-sm text-indigo-600 hover:text-indigo-800"
      = button_to "Удалить", admin_guest_path(@guest), method: :delete, data: { turbo_confirm: "Удалить гостя #{@guest.full_name}?" }, class: "text-sm text-red-500 hover:text-red-700"

  .grid.grid-cols-3.gap-4
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      %p.text-sm.text-slate-500.dark:text-slate-400 Брони
      %p.text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= @bookings.count
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      %p.text-sm.text-slate-500.dark:text-slate-400 Сумма за всё время
      %p.text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@guest.total_spent)
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      %p.text-sm.text-slate-500.dark:text-slate-400 Завершённых заездов
      %p.text-3xl.font-semibold.text-slate-900.dark:text-white.mt-1= @guest.completed_stays

  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Контакты и предпочтения
    %dl.grid.grid-cols-2.gap-x-6.gap-y-4.px-6.py-4.text-sm{:class => "lg:grid-cols-3"}
      %div
        %dt.text-slate-500.dark:text-slate-400 Телефон
        %dd.text-slate-900.dark:text-white= @guest.phone.presence || "—"
      %div
        %dt.text-slate-500.dark:text-slate-400 Email
        %dd.text-slate-900.dark:text-white= @guest.email.presence || "—"
      %div
        %dt.text-slate-500.dark:text-slate-400 Паспорт
        %dd.text-slate-900.dark:text-white= @guest.passport_number.presence || "—"
      %div
        %dt.text-slate-500.dark:text-slate-400 Предпочтения
        %dd.text-slate-900.dark:text-white= @guest.preferences.presence || "—"
      %div
        %dt.text-slate-500.dark:text-slate-400 Гость с
        %dd.text-slate-900.dark:text-white= l(@guest.created_at.to_date, format: :long)
      %div
        %dt.text-slate-500.dark:text-slate-400 Заметки
        %dd.text-slate-900.dark:text-white.whitespace-pre-wrap= @guest.notes.presence || "—"

  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white История броней
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Номер
          %th.px-5.py-3.font-medium Заезд
          %th.px-5.py-3.font-medium Выезд
          %th.px-5.py-3.font-medium Статус
          %th.px-5.py-3.font-medium Сумма
          %th.px-5.py-3.font-medium Оплачено
          %th.px-5.py-3.font-medium.text-right Долг
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - if @bookings.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "7"} Броней пока нет
        - else
          - @bookings.each do |booking|
            %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
              %td.px-5.py-3
                = link_to "№#{booking.id}", admin_booking_path(booking), class: "text-indigo-600 hover:text-indigo-800"
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= l(booking.check_in, format: :short)
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= l(booking.check_out, format: :short)
              %td.px-5.py-3= content_tag :span, booking_status_label(booking.status), class: status_badge_class(booking.status)
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(booking.total_price)
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(booking.paid_amount)
              %td.px-5.py-3.text-right.text-slate-600.dark:text-slate-300= money(booking.due_amount)

  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Возможные дубли
    - if @duplicates.empty?
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Совпадений по телефону, email или паспорту не найдено
    - else
      %ul.divide-y.divide-slate-100.dark:divide-slate-800.text-sm
        - @duplicates.each do |duplicate|
          %li.px-6.py-3.flex.items-center.justify-between.gap-4
            .flex.flex-col.gap-0.5
              %span.font-medium.text-slate-900.dark:text-white
                = duplicate.full_name
                - if duplicate.is_vip
                  %span.text-xs.text-amber-700.ml-2{:class => "dark:text-amber-300"} VIP
              %span.text-xs.text-slate-400.dark:text-slate-500
                - identity = [ duplicate.email.presence, duplicate.phone.presence, duplicate.passport_number.presence ].compact.join(" · ")
                = identity.presence || "нет контактов"
              %span.text-xs.text-slate-400.dark:text-slate-500 Броней: #{duplicate.bookings.count}
            = button_to "Объединить с этим гостем", merge_admin_guest_path(@guest), method: :post, params: { duplicate_id: duplicate.id }, data: { turbo_confirm: "Перенести все брони и данные гостя «#{duplicate.full_name}» к «#{@guest.full_name}» и удалить дубль?" }, class: "text-xs px-3 py-2 rounded-lg border border-amber-300 text-amber-700 hover:bg-amber-50 #{'dark:border-amber-600 dark:text-amber-300 dark:hover:bg-amber-900/20'}"