= form_with model: [:admin, @news], url: @news.new_record? ? admin_news_index_path : admin_news_path(@news), class: "space-y-6" do |form|
  - if @news.errors.any?
    .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
      %strong
        = pluralize(@news.errors.count, "ошибка")
        \:
      = @news.errors.full_messages.to_sentence
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
    %div
      = field_label(form, :title, "Заголовок")
      = text_input(form, :title, placeholder: "Открытие нового SPA-комплекса…")
      = field_errors(form, :title)
    %div
      = field_label(form, :published_at, "Дата публикации")
      = form.datetime_local_field :published_at, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-slate-100 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
    %div
      = field_label(form, :body, "Текст новости")
      = text_area(form, :body, rows: 8, placeholder: "Текст новости…")
  .flex.items-center.gap-3
    = form.submit @news.new_record? ? "Опубликовать" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
    = link_to "Отмена", admin_news_index_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"
