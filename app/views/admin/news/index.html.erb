<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Новости</h1>
    <%= link_to "+ Новая новость", new_admin_news_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Заголовок</th>
          <th class="px-5 py-3 font-medium">Дата публикации</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @news.each do |item| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= item.title %></td>
            <td class="px-5 py-3 text-slate-600"><%= item.published_at ? l(item.published_at, format: :long) : "—" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Редактировать", edit_admin_news_path(item), class: "text-indigo-600 hover:text-indigo-800" %>
              <%= button_to "Удалить", admin_news_path(item), method: :delete,
                  data: { turbo_confirm: "Удалить новость?" },
                  class: "text-red-500 hover:text-red-700 ml-3" %>
            </td>
          </tr>
        <% end %>
        <% if @news.empty? %>
          <tr><td colspan="3" class="px-5 py-8 text-center text-slate-400">Новостей пока нет</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
