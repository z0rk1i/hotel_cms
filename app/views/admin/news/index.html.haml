.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Новости
    = link_to "+ Новая новость", new_admin_news_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Заголовок
          %th.px-5.py-3.font-medium Дата публикации
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @news.each do |item|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= item.title
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= item.published_at ? l(item.published_at, format: :long) : "—"
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Редактировать", edit_admin_news_path(item), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_news_path(item), method: :delete, |
                data: { turbo_confirm: "Удалить новость?" },                 |
                class: "text-red-500 hover:text-red-700 ml-3"                
        - if @news.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "3"} Новостей пока нет
