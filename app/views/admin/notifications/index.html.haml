%section.max-w-4xl.mx-auto.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-bold Уведомления
    - if @notifications.unread.any?
      = button_to "Прочитать все", mark_all_read_admin_notifications_path, method: :post,
        class: "text-sm text-slate-600 dark:text-slate-300 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 px-3 py-1.5 rounded-md transition-colors"

  - if @notifications.none?
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-8.text-center.text-slate-500.dark:text-slate-400
      Уведомлений нет
  - else
    - @notifications.each do |notification|
      .flex.items-start.justify-between.gap-4.bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-4{ class: notification.unread? ? "border-l-4 border-l-red-500" : "opacity-70" }
        .min-w-0
          %p.font-semibold.text-slate-900.dark:text-white= notification.title
          %p.text-sm.text-slate-600.dark:text-slate-300.mt-1= notification.body
          %p.text-xs.text-slate-400.dark:text-slate-500.mt-1
            = l(notification.created_at, format: :long, default: notification.created_at)
        .flex.items-center.gap-2.shrink-0
          = link_to "Открыть", notification_target_path(notification),
            class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline"
          - if notification.unread?
            = button_to "Прочитать", read_admin_notification_path(notification), method: :patch,
              class: "text-sm text-slate-600 dark:text-slate-300 hover:underline"