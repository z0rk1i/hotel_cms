.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Страницы
    = link_to "+ Новая страница", new_admin_page_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Заголовок
          %th.px-5.py-3.font-medium Slug
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @pages.each do |page|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= page.title
            %td.px-5.py-3.text-slate-600.dark:text-slate-300
              %code.text-xs.bg-slate-100.dark:bg-slate-700.rounded{:class => "px-1.5 py-0.5"}= page.slug
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Редактировать", edit_admin_page_path(page), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_page_path(page), method: :delete,  |
                data: { turbo_confirm: "Удалить страницу «#{page.title}»?" }, |
                class: "text-red-500 hover:text-red-700 ml-3"                 
        - if @pages.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "3"} Страниц пока нет
