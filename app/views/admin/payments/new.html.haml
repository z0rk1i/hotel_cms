.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white
      Оплата по брони №#{@booking.id}
    = link_to "← К брони", admin_booking_path(@booking), class: "text-sm text-indigo-600 hover:text-indigo-800"
  = form_with model: [:admin, @booking, @payment], class: "space-y-6" do |form|
    - if @payment.errors.any?
      .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
        %strong
          = pluralize(@payment.errors.count, "ошибка")
          \:
        = @payment.errors.full_messages.to_sentence
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
      .flex.flex-wrap.gap-6.text-sm
        %span.text-slate-500.dark:text-slate-400
          Стоимость:
          %strong.text-slate-900.dark:text-white= money(@booking.total_price)
        %span.text-slate-500.dark:text-slate-400
          Оплачено:
          %strong.text-slate-900.dark:text-white= money(@booking.paid_amount)
        %span.text-slate-500.dark:text-slate-400
          Долг:
          %strong.text-slate-900.dark:text-white= money(@booking.due_amount)
      .grid.grid-cols-2.gap-4
        %div
          = field_label(form, :amount, "Сумма, ₽")
          = number_input(form, :amount, min: 0.01, step: 0.01)
          = field_errors(form, :amount)
        %div
          = field_label(form, :method, "Способ оплаты")
          = select_input(form, :method, Payment.method_labels.map { |label, value| [label, value] }, selected: @payment.method)
          = field_errors(form, :method)
        %div
          = field_label(form, :paid_at, "Дата и время")
          = form.datetime_local_field :paid_at, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-slate-100 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
          = field_errors(form, :paid_at)
      %div
        = field_label(form, :note, "Комментарий")
        = text_area(form, :note, rows: 2, placeholder: "Предоплата, расчёт при выезде…")
    .flex.items-center.gap-3
      = form.submit "Добавить оплату", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
      = link_to "Отмена", admin_booking_path(@booking), class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"