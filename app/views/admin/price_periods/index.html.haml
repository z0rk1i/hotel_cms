.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Ценовые периоды
    = link_to "+ Добавить период", new_admin_price_period_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Название
          %th.px-5.py-3.font-medium Дата начала
          %th.px-5.py-3.font-medium Дата окончания
          %th.px-5.py-3.font-medium Коэффициент
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @price_periods.each do |period|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= period.name
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= l(period.starts_on, format: :short)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= l(period.ends_on, format: :short)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= "×#{period.multiplier}"
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Редактировать", edit_admin_price_period_path(period), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_price_period_path(period), method: :delete, |
                data: { turbo_confirm: "Удалить период?" },                        |
                class: "text-red-500 hover:text-red-700 ml-3"                       
        - if @price_periods.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "5"} Ценовых периодов пока нет
  %p.text-sm.text-slate-500.dark:text-slate-400
    Коэффициент умножается на базовую цену номера за ночь. На не входящие в периоды даты действует базовая цена. Выходные (пт–сб) дополнительно умножаются на коэффициент выходных номера.