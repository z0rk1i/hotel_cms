.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Отчёты
    = link_to "Экспорт CSV", admin_reports_path(format: :csv, from: params[:from], to: params[:to]), class: "border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-medium px-4 py-2 rounded-lg"
  = form_with url: admin_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do
    %div
      %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 С
      = date_field_tag :from, @from, class: "rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
    %div
      %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 По
      = date_field_tag :to, @to, class: "rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
    = submit_tag "Обновить", class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .grid.grid-cols-2.lg:grid-cols-4.gap-4
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Выручка по тарифу
      .text-2xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@report.plan_revenue)
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Принято оплат
      .text-2xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@report.fact_revenue)
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Загрузка
      .text-2xl.font-semibold.text-slate-900.dark:text-white.mt-1= "#{(@report.occupancy_rate * 100).round}%"
      .text-xs.text-slate-400.dark:text-slate-500.mt-1= "#{@report.booked_nights} из #{@report.capacity_nights} ночей"
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-5
      .text-sm.text-slate-500.dark:text-slate-400 Выписавшиеся за период
      .text-2xl.font-semibold.text-slate-900.dark:text-white.mt-1= money(@report.monthly_booked_revenue)
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Загрузка по категориям номеров
    - if @report.by_category.any?
      %table.w-full.text-sm
        %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
          %tr
            %th.px-5.py-3.font-medium Категория
            %th.px-5.py-3.font-medium Ночей занято
            %th.px-5.py-3.font-medium По тарифу, ₽
            %th.px-5.py-3.font-medium Принято, ₽
        %tbody.divide-y.divide-slate-100.dark:divide-slate-800
          - @report.by_category.each do |category, values|
            %tr
              %td.px-5.py-3.text-slate-900.dark:text-white= category
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= values["nights"]
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(values["plan"])
              %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(values["fact"])
    - else
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Данных за период нет
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Ночная загрузка
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Дата
          %th.px-5.py-3.font-medium По тарифу, ₽
          %th.px-5.py-3.font-medium Принято, ₽
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @report.nightly.each do |date, values|
          %tr
            %td.px-5.py-3.text-slate-900.dark:text-white= l(Date.parse(date), format: :long)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(values["plan"])
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(values["fact"])