<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Отзывы</h1>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Все", admin_reviews_path, class: filter_link_class(params[:status].blank?) %>
    <% Review.statuses.each_key do |status| %>
      <%= link_to review_status_label(status), admin_reviews_path(status: status), class: filter_link_class(params[:status] == status) %>
    <% end %>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Автор</th>
          <th class="px-5 py-3 font-medium">Объект</th>
          <th class="px-5 py-3 font-medium">Оценка</th>
          <th class="px-5 py-3 font-medium">Текст</th>
          <th class="px-5 py-3 font-medium">Статус</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @reviews.each do |review| %>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40">
            <td class="px-5 py-3 font-medium text-slate-900 dark:text-white"><%= review.user.full_name.presence || review.user.email %></td>
            <td class="px-5 py-3 text-slate-600 dark:text-slate-300">
              <%= review.reviewable.is_a?(Room) ? "Номер #{review.reviewable.number}" : "Услуга «#{review.reviewable.name}»" %>
            </td>
            <td class="px-5 py-3 text-amber-500"><%= "★" * review.rating %><span class="text-slate-400 dark:text-slate-500"> <%= review.rating %></span></td>
            <td class="px-5 py-3 text-slate-500 dark:text-slate-400 max-w-md truncate"><%= review.body %></td>
            <td class="px-5 py-3"><%= content_tag :span, review_status_label(review.status), class: status_badge_class(review.status) %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap space-x-2">
              <% if review.pending? || review.rejected? %>
                <%= button_to "Одобрить", approve_admin_review_path(review), method: :patch,
                    class: "text-emerald-600 hover:text-emerald-800 text-xs" %>
              <% end %>
              <% if review.pending? || review.approved? %>
                <%= button_to "Отклонить", reject_admin_review_path(review), method: :patch,
                    class: "text-amber-600 hover:text-amber-800 text-xs" %>
              <% end %>
              <%= button_to "Удалить", admin_review_path(review), method: :delete,
                  data: { turbo_confirm: "Удалить отзыв?" },
                  class: "text-red-500 hover:text-red-700 text-xs" %>
            </td>
          </tr>
        <% end %>
        <% if @reviews.empty? %>
          <tr><td colspan="6" class="px-5 py-8 text-center text-slate-400 dark:text-slate-500">Отзывов пока нет</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>