.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Отзывы
  .flex.flex-wrap.gap-2
    = link_to "Все", admin_reviews_path, class: filter_link_class(params[:status].blank?)
    - Review.statuses.each_key do |status|
      = link_to review_status_label(status), admin_reviews_path(status: status), class: filter_link_class(params[:status] == status)
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Автор
          %th.px-5.py-3.font-medium Объект
          %th.px-5.py-3.font-medium Оценка
          %th.px-5.py-3.font-medium Текст
          %th.px-5.py-3.font-medium Статус
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @reviews.each do |review|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= review.user.full_name.presence || review.user.email
            %td.px-5.py-3.text-slate-600.dark:text-slate-300
              = review.reviewable.is_a?(Room) ? "Номер #{review.reviewable.number}" : "Услуга «#{review.reviewable.name}»"
            %td.px-5.py-3.text-amber-500
              = "★" * review.rating
              %span.text-slate-400.dark:text-slate-500
                = review.rating
            %td.px-5.py-3.text-slate-500.dark:text-slate-400.max-w-md.truncate= review.body
            %td.px-5.py-3= content_tag :span, review_status_label(review.status), class: status_badge_class(review.status)
            %td.px-5.py-3.text-right.whitespace-nowrap.space-x-2
              - if review.pending? || review.rejected?
                = button_to "Одобрить", approve_admin_review_path(review), method: :patch, |
                  class: "text-emerald-600 hover:text-emerald-800 text-xs"                 
              - if review.pending? || review.approved?
                = button_to "Отклонить", reject_admin_review_path(review), method: :patch, |
                  class: "text-amber-600 hover:text-amber-800 text-xs"                     
              = button_to "Удалить", admin_review_path(review), method: :delete, |
                data: { turbo_confirm: "Удалить отзыв?" },                       |
                class: "text-red-500 hover:text-red-700 text-xs"                 
        - if @reviews.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "6"} Отзывов пока нет
