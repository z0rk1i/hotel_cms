<%= form_with model: [:admin, @room_category], class: "space-y-6" do |form| %>
  <% if @room_category.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
      <strong><%= pluralize(@room_category.errors.count, "ошибка") %>:</strong>
      <%= @room_category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 space-y-4">
    <div>
      <%= field_label(form, :name, "Название") %>
      <%= text_input(form, :name, placeholder: "Напр. Стандарт, Люкс…") %>
      <%= field_errors(form, :name) %>
    </div>
    <div>
      <%= field_label(form, :base_price, "Базовая цена за ночь, ₽") %>
      <%= number_input(form, :base_price, step: "0.01", min: 0) %>
      <%= field_errors(form, :base_price) %>
    </div>
    <div>
      <%= field_label(form, :description, "Описание") %>
      <%= text_area(form, :description, rows: 3, placeholder: "Чем отличается эта категория…") %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit @room_category.new_record? ? "Создать категорию" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg" %>
    <%= link_to "Отмена", admin_room_categories_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2" %>
  </div>
<% end %>
