<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Категории номеров</h1>
    <%= link_to "+ Добавить категорию", new_admin_room_category_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Название</th>
          <th class="px-5 py-3 font-medium">Базовая цена</th>
          <th class="px-5 py-3 font-medium">Номеров</th>
          <th class="px-5 py-3 font-medium">Описание</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @room_categories.each do |category| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= category.name %></td>
            <td class="px-5 py-3 text-slate-600"><%= money(category.base_price) %></td>
            <td class="px-5 py-3 text-slate-600"><%= category.rooms.count %></td>
            <td class="px-5 py-3 text-slate-500 max-w-xs truncate"><%= category.description %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Редактировать", edit_admin_room_category_path(category), class: "text-indigo-600 hover:text-indigo-800" %>
              <%= button_to "Удалить", admin_room_category_path(category), method: :delete,
                  data: { turbo_confirm: "Удалить категорию #{category.name}?" },
                  class: "text-red-500 hover:text-red-700 ml-3" %>
            </td>
          </tr>
        <% end %>
        <% if @room_categories.empty? %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-slate-400">Категорий пока нет</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
