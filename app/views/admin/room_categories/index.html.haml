.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Категории номеров
    = link_to "+ Добавить категорию", new_admin_room_category_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Название
          %th.px-5.py-3.font-medium Базовая цена
          %th.px-5.py-3.font-medium Номеров
          %th.px-5.py-3.font-medium Описание
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @room_categories.each do |category|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= category.name
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(category.base_price)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= category.rooms.count
            %td.px-5.py-3.text-slate-500.dark:text-slate-400.max-w-xs.truncate= category.description
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "Редактировать", edit_admin_room_category_path(category), class: "text-indigo-600 hover:text-indigo-800"
              = button_to "Удалить", admin_room_category_path(category), method: :delete, |
                data: { turbo_confirm: "Удалить категорию #{category.name}?" },           |
                class: "text-red-500 hover:text-red-700 ml-3"                             
        - if @room_categories.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "5"} Категорий пока нет
