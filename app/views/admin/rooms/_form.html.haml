- if @room.errors.any?
  .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
    %strong
      = pluralize(@room.errors.count, "ошибка")
      \:
    = @room.errors.full_messages.to_sentence
= form_with model: [:admin, @room], class: "space-y-6" do |form|
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
    .grid.grid-cols-2.gap-4
      %div
        = field_label(form, :number, "Номер")
        = text_input(form, :number, placeholder: "101")
        = field_errors(form, :number)
      %div
        = field_label(form, :category, "Категория")
        = text_input(form, :category, placeholder: "Стандарт")
        = field_errors(form, :category)
      %div
        = field_label(form, :floor, "Этаж")
        = number_input(form, :floor, min: 1)
        = field_errors(form, :floor)
      %div
        = field_label(form, :capacity, "Вместимость")
        = number_input(form, :capacity, min: 1)
        = field_errors(form, :capacity)
      %div
        = field_label(form, :size_sqm, "Площадь, м²")
        = number_input(form, :size_sqm, min: 0, step: 0.5)
        = field_errors(form, :size_sqm)
      %div
        = field_label(form, :price_per_night, "Цена за ночь, ₽")
        = number_input(form, :price_per_night, min: 0, step: 100)
        = field_errors(form, :price_per_night)
      %div
        = field_label(form, :weekend_multiplier, "Коэффициент на выходные")
        = number_input(form, :weekend_multiplier, min: 1, step: 0.1)
        = field_errors(form, :weekend_multiplier)
      %div
        = field_label(form, :min_nights, "Минимальное число ночей")
        = number_input(form, :min_nights, min: 1)
        = field_errors(form, :min_nights)
      %div
        = field_label(form, :status, "Статус")
        = select_input(form, :status, %w[available maintenance cleaning].map { |s| [room_status_label(s), s] })
        = field_errors(form, :status)
      %div
        = field_label(form, :amenities, "Удобства")
        = form.select :amenities, offered_amenities.map { |a| [a, a] }, { include_blank: true }, multiple: true, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        = field_errors(form, :amenities)
        %p.mt-1.text-xs.text-slate-400.dark:text-slate-500 Удерживайте Cmd/Ctrl для выбора нескольких
      %div
        = field_label(form, :unavailable_from, "Недоступен с")
        = date_input(form, :unavailable_from)
        = field_errors(form, :unavailable_from)
      %div
        = field_label(form, :unavailable_until, "Недоступен по")
        = date_input(form, :unavailable_until)
        = field_errors(form, :unavailable_until)
    %div
      = field_label(form, :description, "Описание")
      = text_area(form, :description, rows: 4, placeholder: "Описание номера…")
      = field_errors(form, :description)
    %div
      = field_label(form, :photos, "Фотографии")
      - if @room.photos.any?
        .flex.flex-wrap.gap-3.mb-3
          - @room.photos.each do |photo|
            .relative
              = image_tag image_thumb(photo), class: "h-24 w-32 object-cover rounded-lg border border-slate-200"
              = button_to "×", admin_room_photo_path(@room, photo), method: :delete, class: "absolute -top-2 -right-2 w-6 h-6 rounded-full bg-red-600 text-white text-sm leading-none flex items-center justify-center"
      = form.file_field :photos, multiple: true, accept: "image/*",
        class: "block w-full text-sm text-slate-600 dark:text-slate-300 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-600 hover:file:bg-indigo-100"
      = field_errors(form, :photos)
  .flex.items-center.gap-3
    = form.submit @room.new_record? ? "Создать номер" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
    = link_to "Отмена", admin_rooms_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"