= form_with model: [:admin, @room], class: "space-y-6" do |form|
  - if @room.errors.any?
    .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
      %strong
        = pluralize(@room.errors.count, "ошибка")
        \:
      = @room.errors.full_messages.to_sentence
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
    .grid.grid-cols-2.gap-4
      %div
        = field_label(form, :number, "Номер комнаты")
        = text_input(form, :number, placeholder: "Напр. 101")
        = field_errors(form, :number)
      %div
        = field_label(form, :category_id, "Категория")
        = select_input(form, :category_id, RoomCategory.order(:name).map { |c| [c.name, c.id] })
        = field_errors(form, :category_id)
      %div
        = field_label(form, :floor, "Этаж")
        = number_input(form, :floor, min: 0)
        = field_errors(form, :floor)
      %div
        = field_label(form, :size_sqm, "Площадь, м²")
        = number_input(form, :size_sqm, min: 1)
        = field_errors(form, :size_sqm)
      %div
        = field_label(form, :capacity, "Вместимость (чел.)")
        = number_input(form, :capacity, min: 1)
        = field_errors(form, :capacity)
      %div
        = field_label(form, :price_per_night, "Цена за ночь, ₽")
        = number_input(form, :price_per_night, step: "0.01", min: 0)
        = field_errors(form, :price_per_night)
      %div
        = field_label(form, :status, "Статус")
        = select_input(form, :status, Room.statuses.keys.map { |s| [room_status_label(s), s] }, selected: @room.status)
        = field_errors(form, :status)
    %div
      = field_label(form, :description, "Описание")
      = text_area(form, :description, rows: 4, placeholder: "Удобства, вид из окна, оснащение…")
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6
    %div
      %span.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-2 Удобства номера
      - if Amenity.any?
        .grid.grid-cols-2.md:grid-cols-3.gap-3
          - Amenity.order(:name).each do |amenity|
            %label.flex.items-center.gap-2.rounded-lg.border.border-slate-200.dark:border-slate-700.px-3.py-2.text-sm.cursor-pointer{:class => "#{'border-indigo-400 dark:border-indigo-500' if @room.amenities.include?(amenity)}"}
              = form.check_box :amenity_ids, { multiple: true, checked: @room.amenities.include?(amenity) }, amenity.id, nil
              %span.text-slate-800.dark:text-slate-200= amenity.name
      - else
        %p.text-sm.text-slate-400.dark:text-slate-500
          Удобств пока нет — #{link_to "добавьте", admin_amenities_path} в разделе «Удобства».
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6
    %div
      = field_label(form, :photos, "Фотографии номера")
      = form.file_field :photos, multiple: true, accept: "image/*",                                                                                                                                                                                                                                                      |
        class: "block w-full text-sm text-slate-600 dark:text-slate-300 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 dark:file:bg-indigo-900/40 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 dark:file:text-indigo-300 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/60" |
      %p.mt-1.text-xs.text-slate-400.dark:text-slate-500
        Можно выбрать до #{Room::MAX_PHOTOS} изображений, каждое до #{Room::MAX_PHOTO_SIZE / 1.megabyte} МБ (сейчас: #{@room.photos.count})
    - if @room.photos.any?
      .mt-4.grid.grid-cols-4.gap-3
        - @room.photos.select { |photo| photo.persisted? && photo.blob.persisted? }.each do |photo|
          .relative
            = image_tag photo, class: "w-full h-24 object-cover rounded-lg border border-slate-200 dark:border-slate-700"
            = button_to "Удалить", admin_room_photo_path(@room, photo),                           |
              method: :delete, data: { turbo_confirm: "Удалить фото?" },                          |
              class: "absolute top-1 right-1 bg-red-600 text-white text-xs px-1.5 py-0.5 rounded" |
  .flex.items-center.gap-3
    = form.submit @room.new_record? ? "Создать номер" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
    = link_to "Отмена", admin_rooms_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"
