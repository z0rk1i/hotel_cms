<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Номера</h1>
    <%= link_to "+ Добавить номер", new_admin_room_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Все", admin_rooms_path, class: filter_link_class(params[:status].blank?) %>
    <% Room.statuses.each_key do |status| %>
      <%= link_to room_status_label(status), admin_rooms_path(status: status), class: filter_link_class(params[:status] == status) %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Номер</th>
          <th class="px-5 py-3 font-medium">Категория</th>
          <th class="px-5 py-3 font-medium">Этаж</th>
          <th class="px-5 py-3 font-medium">Вместимость</th>
          <th class="px-5 py-3 font-medium">Цена / ночь</th>
          <th class="px-5 py-3 font-medium">Статус</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @rooms.each do |room| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= room.number %></td>
            <td class="px-5 py-3 text-slate-600"><%= room.category.name %></td>
            <td class="px-5 py-3 text-slate-600"><%= room.floor %></td>
            <td class="px-5 py-3 text-slate-600"><%= room.capacity %></td>
            <td class="px-5 py-3 text-slate-600"><%= money(room.price_per_night) %></td>
            <td class="px-5 py-3"><%= content_tag :span, room_status_label(room.status), class: status_badge_class(room.status) %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Редактировать", edit_admin_room_path(room), class: "text-indigo-600 hover:text-indigo-800" %>
              <%= button_to "Удалить", admin_room_path(room), method: :delete,
                  data: { turbo_confirm: "Удалить номер #{room.number}?" },
                  class: "text-red-500 hover:text-red-700 ml-3" %>
            </td>
          </tr>
        <% end %>
        <% if @rooms.empty? %>
          <tr><td colspan="7" class="px-5 py-8 text-center text-slate-400">Номера не найдены</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
