.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Номера
    = link_to "+ Добавить номер", new_admin_room_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .flex.flex-wrap.gap-2
    = link_to "Все", admin_rooms_path, class: filter_link_class(params[:status].blank?)
    - Room.statuses.each_key do |status|
      = link_to room_status_label(status), admin_rooms_path(status: status), class: filter_link_class(params[:status] == status)
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Номер
          %th.px-5.py-3.font-medium Категория
          %th.px-5.py-3.font-medium Этаж
          %th.px-5.py-3.font-medium Вместимость
          %th.px-5.py-3.font-medium Цена / ночь
          %th.px-5.py-3.font-medium Статус
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @rooms.each do |room|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= room.number
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= room.category.name
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= room.floor
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= room.capacity
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(room.price_per_night)
            %td.px-5.py-3
              = content_tag :span, room_status_label(room.status), class: status_badge_class(room.status)
              - if room.cleaning?
                %div.mt-1
                  = button_to "Уборка завершена", complete_cleaning_admin_room_path(room), method: :patch,
                    class: "text-xs text-emerald-700 dark:text-emerald-300 border border-emerald-500 px-2 py-1 rounded-md hover:bg-emerald-50 dark:hover:bg-emerald-900/30"
            %td.px-5.py-3.text-right.whitespace-nowrap
              = link_to "История", status_history_admin_room_path(room), class: "text-slate-500 hover:text-slate-700 dark:hover:text-slate-300"
              = link_to "Редактировать", edit_admin_room_path(room), class: "text-indigo-600 hover:text-indigo-800 ml-3"
              = button_to "Удалить", admin_room_path(room), method: :delete, |
                data: { turbo_confirm: "Удалить номер #{room.number}?" },    |
                class: "text-red-500 hover:text-red-700 ml-3"                
        - if @rooms.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "7"} Номера не найдены
