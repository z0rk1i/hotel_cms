<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Заказы услуг</h1>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Все", admin_service_orders_path, class: filter_link_class(params[:status].blank?) %>
    <% ServiceOrder.statuses.each_key do |status| %>
      <%= link_to service_order_status_label(status), admin_service_orders_path(status: status), class: filter_link_class(params[:status] == status) %>
    <% end %>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 text-left">
        <tr>
          <th class="px-5 py-3 font-medium">Гость</th>
          <th class="px-5 py-3 font-medium">Услуга</th>
          <th class="px-5 py-3 font-medium">Дата</th>
          <th class="px-5 py-3 font-medium">Кол-во</th>
          <th class="px-5 py-3 font-medium">Сумма</th>
          <th class="px-5 py-3 font-medium">Статус</th>
          <th class="px-5 py-3 font-medium text-right">Действия</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @service_orders.each do |order| %>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40">
            <td class="px-5 py-3 font-medium text-slate-900 dark:text-white"><%= order.user.full_name.presence || order.user.email %></td>
            <td class="px-5 py-3 text-slate-600 dark:text-slate-300"><%= order.service.name %></td>
            <td class="px-5 py-3 text-slate-600 dark:text-slate-300 whitespace-nowrap"><%= l(order.service_date, format: :long) %></td>
            <td class="px-5 py-3 text-slate-600 dark:text-slate-300"><%= order.quantity %></td>
            <td class="px-5 py-3 text-slate-600 dark:text-slate-300"><%= money(order.total_price) %></td>
            <td class="px-5 py-3"><%= content_tag :span, service_order_status_label(order.status), class: status_badge_class(order.status) %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap space-x-2">
              <% if order.pending? %>
                <%= button_to "Подтвердить", confirm_admin_service_order_path(order), method: :patch,
                    class: "text-blue-600 hover:text-blue-800 text-xs" %>
                <%= button_to "Отменить", cancel_admin_service_order_path(order), method: :patch,
                    data: { turbo_confirm: "Отменить заказ услуги?" },
                    class: "text-red-500 hover:text-red-700 text-xs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @service_orders.empty? %>
          <tr><td colspan="7" class="px-5 py-8 text-center text-slate-400 dark:text-slate-500">Заказов услуг пока нет</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>