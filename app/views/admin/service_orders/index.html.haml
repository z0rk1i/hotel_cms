.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white Заказы услуг
  .flex.flex-wrap.gap-2
    = link_to "Все", admin_service_orders_path, class: filter_link_class(params[:status].blank?)
    - ServiceOrder.statuses.each_key do |status|
      = link_to service_order_status_label(status), admin_service_orders_path(status: status), class: filter_link_class(params[:status] == status)
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %table.w-full.text-sm
      %thead.bg-slate-50.text-slate-500.dark:text-slate-400.text-left{:class => "dark:bg-slate-800/60"}
        %tr
          %th.px-5.py-3.font-medium Гость
          %th.px-5.py-3.font-medium Услуга
          %th.px-5.py-3.font-medium Дата
          %th.px-5.py-3.font-medium Кол-во
          %th.px-5.py-3.font-medium Сумма
          %th.px-5.py-3.font-medium Статус
          %th.px-5.py-3.font-medium.text-right Действия
      %tbody.divide-y.divide-slate-100.dark:divide-slate-800
        - @service_orders.each do |order|
          %tr.hover:bg-slate-50{:class => "dark:hover:bg-slate-700/40"}
            %td.px-5.py-3.font-medium.text-slate-900.dark:text-white= order.user.full_name.presence || order.user.email
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= order.service.name
            %td.px-5.py-3.text-slate-600.dark:text-slate-300.whitespace-nowrap= l(order.service_date, format: :long)
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= order.quantity
            %td.px-5.py-3.text-slate-600.dark:text-slate-300= money(order.total_price)
            %td.px-5.py-3= content_tag :span, service_order_status_label(order.status), class: status_badge_class(order.status)
            %td.px-5.py-3.text-right.whitespace-nowrap.space-x-2
              - if order.pending?
                = button_to "Подтвердить", confirm_admin_service_order_path(order), method: :patch, |
                  class: "text-blue-600 hover:text-blue-800 text-xs"                                
                = button_to "Отменить", cancel_admin_service_order_path(order), method: :patch, |
                  data: { turbo_confirm: "Отменить заказ услуги?" },                            |
                  class: "text-red-500 hover:text-red-700 text-xs"                              
        - if @service_orders.empty?
          %tr
            %td.px-5.py-8.text-center.text-slate-400.dark:text-slate-500{:colspan => "7"} Заказов услуг пока нет
