= form_with model: [:admin, @service], class: "space-y-6" do |form|
  - if @service.errors.any?
    .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
      %strong
        = pluralize(@service.errors.count, "ошибка")
        \:
      = @service.errors.full_messages.to_sentence
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
    %div
      = field_label(form, :name, "Название")
      = text_input(form, :name, placeholder: "Напр. Завтрак, СПА, Трансфер…")
      = field_errors(form, :name)
    %div
      = field_label(form, :price, "Цена, ₽")
      = number_input(form, :price, step: "0.01", min: 0)
      = field_errors(form, :price)
    %div
      = field_label(form, :description, "Описание")
      = text_area(form, :description, rows: 3)
  .flex.items-center.gap-3
    = form.submit @service.new_record? ? "Добавить услугу" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
    = link_to "Отмена", admin_services_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"
