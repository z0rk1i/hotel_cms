- if @stay.errors.any?
  .rounded-lg.bg-red-50.border.border-red-200.text-red-800.px-4.py-3.text-sm
    %strong
      = pluralize(@stay.errors.count, "ошибка")
      \:
    = @stay.errors.full_messages.to_sentence
= form_with model: [:admin, @stay], class: "space-y-6" do |form|
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
    .grid.grid-cols-2.gap-4
      %div
        = field_label(form, :user_id, "Гость")
        = select_input(form, :user_id, User.guests.order(:full_name).map { |u| ["#{u.full_name} — #{u.phone}", u.id] })
        = field_errors(form, :user_id)
      %div
        = field_label(form, :room_id, "Номер")
        = select_input(form, :room_id, Room.order(:number).map { |r| ["#{r.number} · #{r.category} — #{r.capacity} чел.", r.id] })
        = field_errors(form, :room_id)
      %div
        = field_label(form, :check_in, "Дата заезда")
        = date_input(form, :check_in)
        = field_errors(form, :check_in)
      %div
        = field_label(form, :check_out, "Дата выезда")
        = date_input(form, :check_out)
        = field_errors(form, :check_out)
      %div
        = field_label(form, :guests_count, "Количество гостей")
        = number_input(form, :guests_count, min: 1)
        = field_errors(form, :guests_count)
      %div
        = field_label(form, :status, "Статус")
        = select_input(form, :status, %w[pending confirmed checked_in checked_out cancelled].map { |s| [stay_status_label(s), s] })
        = field_errors(form, :status)
    %div
      = field_label(form, :notes, "Заметки")
      = text_area(form, :notes, rows: 3, placeholder: "Пожелания, особые условия…")
      = field_errors(form, :notes)
  .flex.items-center.gap-3
    = form.submit @stay.new_record? ? "Создать бронь" : "Сохранить", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
    = link_to "Отмена", admin_stays_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"