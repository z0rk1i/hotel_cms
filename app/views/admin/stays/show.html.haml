.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white
      Бронь №#{@stay.id}
    = link_to "← К списку", admin_stays_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4.flex.items-center.justify-between
      %h2.font-medium.text-slate-900.dark:text-white Детали брони
      %span{:class => "inline-block px-2.5 py-1 rounded-full text-xs font-medium #{status_badge_class(@stay.status)}"}
        = stay_status_label(@stay.status)
    %dl.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гость
        %dd.col-span-2.text-slate-900.dark:text-white
          = link_to @stay.user.full_name, admin_user_path(@stay.user), class: "text-indigo-600 hover:text-indigo-800"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Телефон
        %dd.col-span-2.text-slate-900.dark:text-white= @stay.user.phone.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Номер
        %dd.col-span-2.text-slate-900.dark:text-white
          = link_to "#{@stay.room.number} · #{@stay.room.category}", edit_admin_room_path(@stay.room), class: "text-indigo-600 hover:text-indigo-800"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Даты
        %dd.col-span-2.text-slate-900.dark:text-white
          = l(@stay.check_in, format: :long)
          → #{l(@stay.check_out, format: :long)} (#{@stay.nights_count} ночей)
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гостей
        %dd.col-span-2.text-slate-900.dark:text-white= @stay.guests_count
      - if @stay.notes.present?
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Заметки
          %dd.col-span-2.text-slate-900.dark:text-white.whitespace-pre-wrap= @stay.notes
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Стоимость
        %dd.col-span-2.font-medium.text-slate-900.dark:text-white= money(@stay.total_price)
      - if @stay.price_breakdown.any?
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Стоимость по ночам
          %dd.col-span-2.text-slate-900.dark:text-white
            - @stay.price_breakdown.each do |entry|
              .flex.justify-between.gap-4
                %span= l(Date.parse(entry["date"]), format: :short)
                %span.text-slate-500.dark:text-slate-400= money(entry["amount"])
            - if @stay.price_frozen_on
              %p.mt-2.text-xs.text-slate-400.dark:text-slate-500
                Цена зафиксирована по тарифу на #{l(@stay.price_frozen_on, format: :long)} и не меняется при изменении тарифов.
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Оплаты
    .px-6.py-3.flex.flex-wrap.gap-6.text-sm.border-b.border-slate-100.dark:border-slate-700
      %span.text-slate-500.dark:text-slate-400
        Оплачено:
        %strong.text-slate-900.dark:text-white= money(@stay.paid_amount)
      %span.text-slate-500.dark:text-slate-400
        Долг:
        %strong.text-slate-900.dark:text-white= money(@stay.due_amount)
    - if @stay.payments.any?
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @stay.payments.each do |payment|
          %li.flex.items-center.justify-between.gap-4.px-6.py-3
            .flex.items-center.flex-wrap.gap-3
              %span.font-medium.text-slate-900.dark:text-white= money(payment["amount"])
              %span.text-xs.text-slate-500.dark:text-slate-400= payment_method_label(payment["method"])
              %span.text-xs.text-slate-400.dark:text-slate-500= l(Time.zone.parse(payment["paid_at"]), format: :long)
              - if payment["note"].present?
                %span.text-xs.text-slate-400.dark:text-slate-500= payment["note"]
            = button_to "Удалить", remove_payment_admin_stay_path(@stay, payment_id: payment["id"]), method: :delete, data: { turbo_confirm: "Удалить оплату?" }, class: "text-xs text-red-500 hover:text-red-700"
    - else
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Оплат нет
    - unless @stay.checked_out? || @stay.cancelled?
      = form_with url: add_payment_admin_stay_path(@stay), class: "flex flex-wrap gap-3 px-6 py-4 border-t border-slate-100 dark:border-slate-700 items-end" do
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Сумма
          = text_field_tag :amount, nil, type: :number, min: 1, step: 100, required: true, class: "w-32 rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Способ
          = select_tag :method, options_for_select(Stay::PAYMENT_METHODS.map { |m| [payment_method_label(m), m] }), class: "rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Дата
          = date_field_tag :paid_at, Date.current, class: "rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div.flex-1
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Примечание
          = text_field_tag :note, nil, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        = submit_tag "Добавить", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4.flex.items-center.justify-between
      %h2.font-medium.text-slate-900.dark:text-white Услуги
      %span.text-sm.text-slate-500.dark:text-slate-400 Итого: #{money(@stay.services_total)}
    - if @stay.services.any?
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @stay.services.each do |service|
          %li.flex.items-center.justify-between.gap-4.px-6.py-3
            .flex.items-center.flex-wrap.gap-3
              %span.font-medium.text-slate-900.dark:text-white= service["name"]
              %span.text-xs.text-slate-500.dark:text-slate-400
                = money(service["price"])
                × #{service["quantity"]}
              %span.text-xs.text-slate-400.dark:text-slate-500= l(Date.parse(service["date"]), format: :long)
              - if service["status"] == "cancelled"
                %span.text-xs.text-red-500 Отменена
            .flex.items-center.gap-3
              - if service["status"] != "cancelled"
                = button_to "Отменить", cancel_service_admin_stay_path(@stay, service_id: service["id"]), method: :delete, data: { turbo_confirm: "Отменить услугу?" }, class: "text-xs text-red-500 hover:text-red-700"
    - else
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Услуг нет
    - unless @stay.checked_out? || @stay.cancelled?
      = form_with url: add_service_admin_stay_path(@stay), class: "flex flex-wrap gap-3 px-6 py-4 border-t border-slate-100 dark:border-slate-700 items-end" do
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Название
          = text_field_tag :name, nil, required: true, placeholder: "Завтрак", class: "w-40 rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Цена
          = text_field_tag :price, nil, type: :number, min: 0, step: 50, required: true, class: "w-28 rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Кол-во
          = text_field_tag :quantity, 1, type: :number, min: 1, class: "w-20 rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Дата
          = date_field_tag :date, Date.current, class: "rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        %div.flex-1
          %label.block.text-xs.font-medium.text-slate-500.dark:text-slate-400.mb-1 Примечание
          = text_field_tag :note, nil, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800"
        = submit_tag "Добавить", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
  .flex.items-center.gap-3
    - if @stay.pending?
      = button_to "Подтвердить", confirm_admin_stay_path(@stay), method: :patch, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
    - if @stay.confirmed?
      = button_to "Заселить", check_in_admin_stay_path(@stay), method: :patch, class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
    - if @stay.checked_in?
      = button_to "Выселить", check_out_admin_stay_path(@stay), method: :patch, class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium px-4 py-2 rounded-lg"
    - unless @stay.checked_out? || @stay.cancelled?
      = button_to "Отменить", cancel_admin_stay_path(@stay), method: :patch, data: { turbo_confirm: "Отменить бронь?" }, class: "border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium px-4 py-2 rounded-lg"
      = link_to "Редактировать", edit_admin_stay_path(@stay), class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg"
    = button_to "Удалить", admin_stay_path(@stay), method: :delete, data: { turbo_confirm: "Удалить бронь?" }, class: "text-red-500 hover:text-red-700 text-sm px-3 py-2 ml-auto"