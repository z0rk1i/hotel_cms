.space-y-6
  .flex.items-center.justify-between
    %h1.text-2xl.font-semibold.text-slate-900.dark:text-white= @user.full_name
    .flex.items-center.gap-3
      - if @user.is_vip
        %span.text-xs.font-semibold.text-amber-800.bg-amber-100.rounded-full.px-2.py-0.5{:class => "dark:bg-amber-900/40 dark:text-amber-200"} VIP
      = button_to @user.is_vip ? "Снять VIP" : "Сделать VIP", toggle_vip_admin_user_path(@user), method: :patch, class: "text-sm font-medium px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-white"
      = link_to "← К списку", admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-800"
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    %dl.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Полное имя
        %dd.col-span-2.text-slate-900.dark:text-white= @user.full_name.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Телефон
        %dd.col-span-2.text-slate-900.dark:text-white= @user.phone.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Email
        %dd.col-span-2.text-slate-900.dark:text-white= @user.email.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Паспорт
        %dd.col-span-2.text-slate-900.dark:text-white= @user.passport_number.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Согласие на обработку данных
        %dd.col-span-2.text-slate-900.dark:text-white= @user.has_consent? ? "Да, с #{l(@user.consent_signed_at.to_date, format: :long)}" : "Нет"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Предпочтения
        %dd.col-span-2.text-slate-900.dark:text-white.whitespace-pre-wrap= @user.preferences.presence || "—"
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Итого потрачено
        %dd.col-span-2.text-slate-900.dark:text-white= money(@user.total_spent)
  - if @user.possible_duplicates.any?
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
      .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
        %h2.font-medium.text-slate-900.dark:text-white Возможные дубликаты
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @user.possible_duplicates.each do |duplicate|
          %li.flex.items-center.justify-between.px-6.py-3
            %div
              .font-medium.text-slate-900.dark:text-white= duplicate.full_name
              .text-sm.text-slate-500.dark:text-slate-400= duplicate.phone.presence || duplicate.email
            %form{:action => merge_into_admin_user_path(@user), :method => "post", :style => "display:inline", :onsubmit => "return confirm('Объединить профили?')"}
              = csrf_field
              %input{:name => "target_user_id", :type => "hidden", :value => duplicate.id}/
              %button{:type => "submit", :class => "text-sm text-indigo-600 hover:text-indigo-800"} Объединить сюда
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4
      %h2.font-medium.text-slate-900.dark:text-white Брони (#{@stays.count})
    - if @stays.any?
      %ul.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
        - @stays.each do |stay|
          %li
            %a.px-6.py-3.flex.items-center.justify-between.hover:bg-slate-50.transition-colors{:class => "dark:hover:bg-slate-700/40", :href => admin_stay_path(stay)}
              %div
                .font-medium.text-slate-900.dark:text-white
                  №#{stay.id} — номер #{stay.room.number}
                .text-sm.text-slate-500.dark:text-slate-400
                  = l(stay.check_in, format: :long)
                  → #{l(stay.check_out, format: :long)} · #{stay.nights_count} ночей
              %div.text-right
                = content_tag :span, stay_status_label(stay.status), class: status_badge_class(stay.status)
                %p.mt-1.text-sm.font-medium.text-slate-900.dark:text-white= money(stay.total_price)
    - else
      .px-6.py-4.text-sm.text-slate-400.dark:text-slate-500 Броней нет