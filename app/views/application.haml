!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Hotel CMS"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Hotel CMS", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tag
    = content_for(:head)
    :javascript
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("hotel-theme"); } catch (e) {}
        var dark = saved ? saved === "dark"
                         : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    %link{:href => "/assets/tailwind.css", :rel => "stylesheet"}/
    %script{:src => "/assets/application.js", :type => "module"}/
  %body.bg-white.text-slate-800.dark:bg-slate-900.dark:text-slate-100.font-sans.antialiased.min-h-screen
    = partial :"public_site/nav"
    = yield
    = partial :"public_site/footer"