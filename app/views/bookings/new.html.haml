.max-w-3xl.mx-auto.px-6.py-12
  %h1.text-2xl.font-semibold.text-slate-900.dark:text-white.mb-2 Бронирование номера
  %p.text-slate-500.dark:text-slate-400.mb-8 Заполните даты и контактные данные — подтверждение придёт от отеля.
  - if notice.present?
    .mb-6.rounded-lg.bg-emerald-50.border.border-emerald-200.text-emerald-800.dark:text-emerald-200.px-4.py-3.text-sm{:class => "dark:bg-emerald-900/40 dark:border-emerald-700/50"}= notice
  - if alert.present?
    .mb-6.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}= alert
  - if defined?(@errors) && @errors.any?
    .mb-6.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}
      %strong
        = pluralize(@errors.count, "ошибка")
        \:
      = @errors.uniq.to_sentence
  = form_tag bookings_path, class: "space-y-6" do
    %div{"data-booking-form-exclude-value" => "0", "data-booking-form-url-value" => bookings_available_rooms_path, "data-controller" => "booking-form"}
      .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
        %h2.font-medium.text-slate-900.dark:text-white Номер и даты
        .grid.grid-cols-2.gap-4
          %div
            %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "check_in"} Дата заезда
            %input#check_in.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{"data-booking-form-target" => "checkIn", "data-action" => "change->booking-form#refreshRooms", :max => nil, :min => Date.current, :name => "check_in", :required => "", :type => "date", :value => @from}
          %div
            %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "check_out"} Дата выезда
            %input#check_out.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{"data-booking-form-target" => "checkOut", "data-action" => "change->booking-form#refreshRooms", :min => Date.current + 1, :name => "check_out", :required => "", :type => "date", :value => @to}
        .grid.grid-cols-2.gap-4
          %div
            %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "room_id"} Номер
            - selected_room = @room
            %select#room_id.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none.bg-white.dark:bg-slate-800.dark:text-slate-100{"data-booking-form-target" => "room", "data-action" => "change->booking-form#updateTotal", :name => "room_id"}
              - if selected_room
                %option{:selected => "", :value => selected_room.id}= "#{selected_room.number} · #{selected_room.category}"
              - else
                %option{:value => ""} Выберите даты…
          %div
            %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "guests_count"} Количество гостей
            %input#guests_count.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:min => 1, :name => "guests_count", :type => "number", :value => @guests}
        .text-sm.font-medium.text-indigo-600.dark:text-indigo-400.hidden{"data-booking-form-target" => "summary"}
        %div
          %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "notes"} Пожелания
          %textarea#notes.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.dark:placeholder-slate-500.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:name => "notes", :placeholder => "Например: поздний заезд, детская кроватка…", :rows => 2}
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
      %h2.font-medium.text-slate-900.dark:text-white Ваши данные
      %span.block.text-xs.text-slate-400.dark:text-slate-500 Привяжет бронь к аккаунту для отслеживания
      .grid.grid-cols-2.gap-4
        .col-span-2
          %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "full_name"} ФИО
          %input#full_name.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.dark:placeholder-slate-500.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:name => "full_name", :placeholder => "Иванов Иван Иванович", :required => "", :type => "text"}
        %div
          %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "email"} Email
          %input#email.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.dark:placeholder-slate-500.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:name => "email", :placeholder => "you@example.com", :type => "email"}
        %div
          %label.block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-1{:for => "phone"} Телефон
          %input#phone.w-full.rounded-lg.border.border-slate-300.dark:border-slate-600.bg-white.dark:bg-slate-800.dark:text-slate-100.dark:placeholder-slate-500.px-3.py-2.text-sm.focus:ring-2.focus:ring-indigo-500.outline-none{:name => "phone", :placeholder => "+7 900 000-00-00", :type => "tel"}
    .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
      %label.flex.items-start.gap-3.cursor-pointer
        = check_box_tag :consent, "1", false, required: true, class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
        %span.text-sm.text-slate-600.dark:text-slate-300
          Я согласен на обработку персональных данных (152-ФЗ) согласно
          = link_to "политике обработки персональных данных", privacy_policy_path, class: "text-indigo-600 hover:text-indigo-800 underline"
      = submit_tag "Забронировать", class: "w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-8 py-3 rounded-lg transition-colors"