<div class="max-w-3xl mx-auto px-6 py-12">
  <div class="rounded-xl border border-emerald-200 dark:border-emerald-700/50 bg-emerald-50 dark:bg-emerald-900/40 p-6 mb-8">
    <div class="flex items-center gap-3">
      <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      <div>
        <h1 class="text-xl font-semibold text-emerald-800 dark:text-emerald-200">Бронь создана!</h1>
        <p class="text-sm text-emerald-700 dark:text-emerald-300 mt-0.5">Отель подтвердит бронь — следите за статусом на этой странице.</p>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="border-b border-slate-200 dark:border-slate-700 px-6 py-4 flex items-center justify-between">
      <h2 class="font-medium text-slate-900 dark:text-white">Бронь №<%= @booking.id %></h2>
      <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium <%= status_badge_class(@booking.status) %>">
        <%= booking_status_label(@booking.status) %>
      </span>
    </div>

    <dl class="divide-y divide-slate-100 dark:divide-slate-700 text-sm">
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Гость</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.guest.full_name %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Номер</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white">№<%= @booking.room.number %> — <%= @booking.room.category.name %> (<%= @booking.room.capacity %> чел., <%= @booking.room.size_sqm %> м²)</dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Даты</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= l(@booking.check_in, format: :long) %> → <%= l(@booking.check_out, format: :long) %> (<%= @booking.nights %> ночей)</dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Гостей</dt>
        <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.guests_count %></dd>
      </div>
      <% if @booking.notes.present? %>
        <div class="grid grid-cols-3 gap-4 px-6 py-3">
          <dt class="text-slate-500 dark:text-slate-400">Пожелания</dt>
          <dd class="col-span-2 text-slate-900 dark:text-white"><%= @booking.notes %></dd>
        </div>
      <% end %>
      <div class="grid grid-cols-3 gap-4 px-6 py-3">
        <dt class="text-slate-500 dark:text-slate-400">Стоимость</dt>
        <dd class="col-span-2 font-medium text-slate-900 dark:text-white"><%= number_to_currency(@booking.total_price, unit: "₽", precision: 0) %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6 flex items-center gap-4">
    <%= link_to "Личный кабинет", account_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
    <%= link_to "На главную", root_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
  </div>
</div>
