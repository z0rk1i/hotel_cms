.max-w-3xl.mx-auto.px-6.py-12
  .rounded-xl.border.border-emerald-200.bg-emerald-50.p-6.mb-8{:class => "dark:border-emerald-700/50 dark:bg-emerald-900/40"}
    .flex.items-center.gap-3
      %svg.w-6.h-6.text-emerald-600.dark:text-emerald-400.shrink-0{:fill => "none", :stroke => "currentColor", "stroke-width" => "2", :viewbox => "0 0 24 24"}
        %path{:d => "M5 13l4 4L19 7", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
      %div
        %h1.text-xl.font-semibold.text-emerald-800.dark:text-emerald-200 Бронь создана!
        %p.text-sm.text-emerald-700.dark:text-emerald-300{:class => "mt-0.5"} Отель подтвердит бронь — следите за статусом на этой странице.
  .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    .border-b.border-slate-200.dark:border-slate-700.px-6.py-4.flex.items-center.justify-between
      %h2.font-medium.text-slate-900.dark:text-white
        Бронь №#{@booking.id}
      %span{:class => "inline-block px-2.5 py-1 rounded-full text-xs font-medium #{status_badge_class(@booking.status)}"}
        = booking_status_label(@booking.status)
    %dl.divide-y.divide-slate-100.dark:divide-slate-700.text-sm
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гость
        %dd.col-span-2.text-slate-900.dark:text-white= @booking.guest.full_name
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Номер
        %dd.col-span-2.text-slate-900.dark:text-white
          №#{@booking.room.number} — #{@booking.room.category.name} (#{@booking.room.capacity} чел., #{@booking.room.size_sqm} м²)
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Даты
        %dd.col-span-2.text-slate-900.dark:text-white
          = l(@booking.check_in, format: :long)
          → #{l(@booking.check_out, format: :long)} (#{@booking.nights} ночей)
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Гостей
        %dd.col-span-2.text-slate-900.dark:text-white= @booking.guests_count
      - if @booking.notes.present?
        .grid.grid-cols-3.gap-4.px-6.py-3
          %dt.text-slate-500.dark:text-slate-400 Пожелания
          %dd.col-span-2.text-slate-900.dark:text-white= @booking.notes
      .grid.grid-cols-3.gap-4.px-6.py-3
        %dt.text-slate-500.dark:text-slate-400 Стоимость
        %dd.col-span-2.font-medium.text-slate-900.dark:text-white= number_to_currency(@booking.total_price, unit: "₽", precision: 0)
  .mt-6.flex.items-center.gap-4
    = link_to "Личный кабинет", account_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800"
    = link_to "На главную", root_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800"
