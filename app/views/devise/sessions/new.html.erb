<div class="min-h-screen flex items-center justify-center bg-slate-100 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
      <h1 class="text-2xl font-semibold text-slate-900 text-center">Hotel CMS</h1>
      <p class="text-sm text-slate-500 text-center mt-1 mb-8">Вход в панель управления</p>

      <% if alert.present? %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
          <%= alert %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" %>
          </div>

          <div>
            <%= f.label :password, "Пароль", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2">
              <%= f.check_box :remember_me, class: "rounded border-slate-300" %>
              <%= f.label :remember_me, "Запомнить меня", class: "text-sm text-slate-600" %>
            </div>
          <% end %>

          <%= f.submit "Войти", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg mt-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
