!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Hotel CMS — Админка"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Hotel CMS", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    :javascript
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("hotel-theme"); } catch (e) {}
        var dark = saved ? saved === "dark"
                         : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-slate-100.text-slate-800.dark:bg-slate-900.dark:text-slate-100.min-h-screen
    .flex.min-h-screen
      = render "layouts/admin/sidebar"
      .flex-1.flex.flex-col.min-w-0
        = render "layouts/admin/topbar"
        %main.flex-1.p-6.lg:p-8
          = render "layouts/admin/flash"
          = yield
