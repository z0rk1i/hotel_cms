      <span>Дашборд</span>
    <% end %>
    <%= link_to admin_bookings_path, class: nav_link_class(admin_bookings_path) do %>
      <span>Бронирования</span>
    <% end %>
    <%= link_to admin_rooms_path, class: nav_link_class(admin_rooms_path) do %>
