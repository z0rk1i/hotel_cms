<header class="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between">
  <div class="text-sm text-slate-500">
    <%= current_administrator.email %>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "На сайт", root_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
    <%= button_to "Выйти", destroy_administrator_session_path, method: :delete,
        class: "text-sm text-slate-600 hover:text-white bg-slate-200 hover:bg-red-600 px-3 py-1.5 rounded-md transition-colors" %>
  </div>
</header>
