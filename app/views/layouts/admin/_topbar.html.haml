%header.bg-white.dark:bg-slate-800.border-b.border-slate-200.dark:border-slate-700.px-6.py-3.flex.items-center.justify-between
  .text-sm.text-slate-500.dark:text-slate-400
    = current_user.email
  .flex.items-center.gap-3
    = link_to "На сайт", root_path, class: "text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    %button.inline-flex.items-center.justify-center.w-8.h-8.rounded-lg.bg-slate-100.dark:bg-slate-700.text-slate-600.dark:text-slate-300.hover:bg-slate-200.dark:hover:bg-slate-600.transition-colors{"aria-label" => "Переключить тему", "data-action" => "click->theme#toggle", "data-controller" => "theme", "data-theme-target" => "icon", :type => "button"}
      = render "shared/theme_icon"
    = button_to "Выйти", destroy_user_session_path, method: :delete, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-white bg-slate-200 dark:bg-slate-700 hover:bg-red-600 px-3 py-1.5 rounded-md transition-colors"