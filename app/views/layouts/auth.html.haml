!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Вход"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "Hotel", :name => "application-name"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    :javascript
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("hotel-theme"); } catch (e) {}
        var dark = saved ? saved === "dark"
                         : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-slate-50.text-slate-800.dark:bg-slate-950.dark:text-slate-200.font-sans.antialiased.min-h-screen
    = yield