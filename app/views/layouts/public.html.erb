<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Гостиница — официальный сайт" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Hotel">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-slate-800 font-sans antialiased">
    <%= render "public_site/nav" %>
    <main>
      <%= yield %>
    </main>
    <%= render "public_site/footer" %>
  </body>
</html>
