<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  </head>

  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #0f172a;">
      <h1 style="font-size: 20px; margin: 0 0 12px;">Гостиница</h1>
      <p style="margin: 0 0 16px;">Здравствуйте, <%= @user.full_name.presence || @user.email %>!</p>
      <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.5;"><%= @notification.body %></p>
      <p style="margin: 0;">
        <%= link_to "Открыть личный кабинет", account_url %>
      </p>
    </div>
  </body>
</html>