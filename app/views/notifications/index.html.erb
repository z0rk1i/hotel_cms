<div class="max-w-3xl mx-auto px-6 py-12">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Уведомления</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Статусы ваших броней и заказов услуг</p>
    </div>
    <%= button_to "Отметить все прочитанными", mark_all_read_notifications_path, method: :post,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <% if notice.present? %>
    <div class="mb-6 rounded-lg bg-emerald-50 dark:bg-emerald-900/40 border border-emerald-200 dark:border-emerald-700/50 text-emerald-800 dark:text-emerald-200 px-4 py-3 text-sm"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-6 rounded-lg bg-red-50 dark:bg-red-900/40 border border-red-200 dark:border-red-700/50 text-red-800 dark:text-red-200 px-4 py-3 text-sm"><%= alert %></div>
  <% end %>

  <% if @notifications.none? %>
    <p class="text-slate-500 dark:text-slate-400">У вас пока нет уведомлений.</p>
  <% else %>
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 overflow-hidden">
      <ul class="divide-y divide-slate-100 dark:divide-slate-700">
        <% @notifications.each do |notification| %>
          <li class="px-5 py-4 flex items-start justify-between gap-4 <%= 'bg-slate-50 dark:bg-slate-700/40' if notification.unread? %>">
            <div>
              <p class="text-sm font-medium text-slate-900 dark:text-white"><%= notification.title %></p>
              <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400"><%= notification.body %></p>
              <p class="mt-1 text-xs text-slate-400 dark:text-slate-500"><%= l(notification.created_at, format: :long) %></p>
            </div>
            <% if notification.unread? %>
              <%= button_to "Прочитано", read_notification_path(notification), method: :patch,
                  class: "shrink-0 text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "Назад в личный кабинет", account_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
  </div>
</div>