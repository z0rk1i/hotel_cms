.bg-slate-900.text-white
  .max-w-6xl.mx-auto.px-6.py-24.text-center
    %h1.text-4xl.md:text-5xl.font-semibold.tracking-tight Добро пожаловать в гостиницу
    %p.mt-4.text-lg.text-slate-300.max-w-2xl.mx-auto Уютные номера, завтраки и внимательный персонал. Бронируйте напрямую — без посредников и комиссий.
    %form.mt-10.mx-auto.max-w-2xl.rounded-2xl.p-5.flex.flex-wrap.items-end.justify-center.gap-3{:action => root_path, :method => "get", :class => "bg-white/10 backdrop-blur"}
      %label.block.text-left
        %span.block.text-xs.text-slate-300.mb-1 Заезд
        %input{:type => "date", :name => "check_in", :value => params["check_in"], :class => "rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-white"}
      %label.block.text-left
        %span.block.text-xs.text-slate-300.mb-1 Выезд
        %input{:type => "date", :name => "check_out", :value => params["check_out"], :class => "rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-white"}
      %label.block.text-left
        %span.block.text-xs.text-slate-300.mb-1 Гостей
        %input{:type => "number", :name => "guests_count", :value => params["guests_count"], :min => 1, :placeholder => "1", :class => "w-20 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-white"}
      %button.bg-indigo-500.hover:bg-indigo-400.text-white.font-medium.px-6.py-2.rounded-lg.transition-colors Найти номера
    %a.mt-6.inline-block.text-slate-300.hover:text-white.text-sm.transition-colors{:href => "#rooms"} или просто смотреть номера
%section#rooms.max-w-6xl.mx-auto.px-6.py-16
  %h2.text-2xl.font-semibold.text-slate-900.dark:text-white.mb-4 Наши номера
  - if availability_search?
    .mb-6.flex.items-center.justify-between.rounded-xl.border.border-indigo-200.bg-indigo-50.px-4.py-3{:class => "dark:border-indigo-800 dark:bg-indigo-900/30"}
      %p.text-sm.text-indigo-800.dark:text-indigo-200
        = "Свободные номера #{format_search_dates} #{search_guests_label}" .strip
      = link_to "Сбросить", root_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 dark:text-indigo-400"
  - if @date_error
    .mb-6.rounded-xl.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-800{:class => "dark:border-red-800 dark:bg-red-900/30 dark:text-red-200"}
      = @date_error
  - if offered_amenities.any?
    .mb-4.flex.flex-wrap.items-center.gap-2
      = link_to "Все номера", rooms_search_path(amenities: []), class: amenity_chip_class(selected_amenities.empty?)
      - offered_amenities.each do |amenity|
        = amenity_filter_link(amenity)
  - if @filter_categories.any?
    .mb-4.flex.flex-wrap.items-center.gap-2
      = link_to "Все типы", rooms_search_path(category: nil), class: amenity_chip_class(params["category"].blank?)
      - @filter_categories.each do |category|
        = link_to category, rooms_search_path(category: category), class: amenity_chip_class(params["category"] == category)
  .mb-6.flex.items-center.gap-3
    %span.text-sm.text-slate-500.dark:text-slate-400 Сортировка:
    = link_to "по цене ↑", rooms_search_path(sort: "price_asc"), class: sort_link_class("price_asc")
    = link_to "по цене ↓", rooms_search_path(sort: "price_desc"), class: sort_link_class("price_desc")
  - @categories.each do |category|
    - rooms = @rooms_by_category.fetch(category, [])
    .mb-10
      .flex.items-baseline.justify-between.mb-4
        %h3.text-xl.font-medium.text-slate-900.dark:text-white= category
        %span.text-sm.text-slate-500.dark:text-slate-400
          от #{money(rooms.map(&:price_per_night).min.to_i)} / ночь
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6
        - rooms.each do |room|
          %a.group.block.rounded-xl.border.border-slate-200.dark:border-slate-700.overflow-hidden.bg-white.dark:bg-slate-800.shadow-sm.hover:border-indigo-400.dark:hover:border-indigo-500.hover:shadow-md.transition-all{:href => room_path(room)}
            - if room.photos.any?
              = image_tag room.photos.first.thumb_url, class: "w-full h-44 object-cover"
            - else
              .w-full.h-44.bg-slate-100.dark:bg-slate-700.flex.items-center.justify-center.text-slate-300.text-sm Нет фото
            .p-4
              .flex.items-center.justify-between
                %span.font-medium.text-slate-900.dark:text-white.group-hover:text-indigo-600.dark:group-hover:text-indigo-400.transition-colors
                  Номер #{room.number}
                %span.text-indigo-600.font-medium
                  = money(room.price_per_night)
                  \/ночь
              .mt-2.text-sm.text-slate-500.dark:text-slate-400
                = room.capacity
                чел. · #{room.size_sqm ? "#{room.size_sqm} м²" : "—"} · этаж #{room.floor}
              - if room.amenities.any?
                .mt-3.flex.flex-wrap.gap-1.5
                  - room.amenities.each do |amenity|
                    %span.inline-flex.items-center.gap-1.rounded-full.bg-indigo-50.px-2.5.py-0.5.text-xs.font-medium.text-indigo-600{:class => "dark:bg-indigo-900/40 dark:text-indigo-300"}
                      = amenity
              - if room.review_average.positive?
                .mt-2.flex.items-center.gap-1.text-xs.text-amber-500
                  - 5.times do |i|
                    %svg{:class => "w-3.5 h-3.5 #{i < room.review_average.round ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600'}", :viewbox => "0 0 24 24"}
                      %path{:d => "M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"}
                  %span.font-medium.text-slate-600.dark:text-slate-400= room.review_average
              - if room.description.present?
                %p.mt-2.text-sm.text-slate-500.dark:text-slate-400.line-clamp-2= room.description
              %span.mt-4.inline-block.w-full.text-center.bg-slate-900.hover:bg-slate-700.text-white.text-sm.font-medium.py-2.rounded-lg.transition-colors.dark:bg-indigo-600.dark:hover:bg-indigo-500 Забронировать
  - if @categories.empty?
    %p.text-slate-400.dark:text-slate-500.text-center.py-10
      - if availability_search?
        На выбранные даты свободных номеров нет — попробуйте другие даты.
      - else
        Номера появятся скоро
- if @news.any?
  %section#news.max-w-6xl.mx-auto.px-6.py-16
    %h2.text-2xl.font-semibold.text-slate-900.dark:text-white.mb-8 Новости
    .grid.grid-cols-1.md:grid-cols-3.gap-6
      - @news.first(3).each do |item|
        %a.block.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.hover:border-indigo-400.dark:hover:border-indigo-500.hover:shadow-sm.transition-colors{:href => news_article_path(item["slug"])}
          %time.text-xs.text-slate-400.dark:text-slate-500= I18n.l(Date.parse(item["date"]), format: :long)
          %h3.mt-1.font-medium.text-slate-900.dark:text-white= item["title"]
          - if item["body"].present?
            %p.mt-2.text-sm.text-slate-500.dark:text-slate-400.line-clamp-3= item["body"]
          %span.mt-3.inline-block.text-sm.font-medium.text-indigo-600.dark:text-indigo-400 Читать далее
- if @gallery_rooms.any?
  %section#gallery.max-w-6xl.mx-auto.px-6.py-16
    .flex.items-center.justify-between.mb-8
      %h2.text-2xl.font-semibold.text-slate-900.dark:text-white Галерея
      = link_to "Смотреть все", gallery_path, class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800"
    .grid.grid-cols-2.md:grid-cols-4.gap-4
      - @gallery_rooms.each do |room|
        - room.photos.each do |photo|
          %a.block.group{:href => room_path(room)}
            = image_tag photo.thumb_url, alt: "Номер #{room.number}", class: "w-full h-40 object-cover rounded-xl group-hover:opacity-90 transition-opacity"