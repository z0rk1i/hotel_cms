<div class="bg-slate-900 text-white">
  <div class="max-w-6xl mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Добро пожаловать в гостиницу</h1>
    <p class="mt-4 text-lg text-slate-300 max-w-2xl mx-auto">Уютные номера, завтраки и внимательный персонал. Бронируйте напрямую — без посредников и комиссий.</p>
    <a href="#rooms" class="mt-8 inline-block bg-indigo-500 hover:bg-indigo-400 text-white font-medium px-8 py-3 rounded-lg transition-colors">Смотреть номера</a>
  </div>
</div>

<section id="rooms" class="max-w-6xl mx-auto px-6 py-16">
  <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-8">Наши номера</h2>

  <% @categories.each do |category| %>
    <div class="mb-10">
      <div class="flex items-baseline justify-between mb-4">
        <h3 class="text-xl font-medium text-slate-900 dark:text-white"><%= category.name %></h3>
        <span class="text-sm text-slate-500 dark:text-slate-400">от <%= number_to_currency(category.base_price, unit: "₽", precision: 0) %> / ночь</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% category.rooms.each do |room| %>
          <%= link_to room_path(room), class: "group block rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800 shadow-sm hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all" do %>
            <% if room.photos.any? %>
              <%= image_tag room.photos.first, class: "w-full h-44 object-cover" %>
            <% else %>
              <div class="w-full h-44 bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-300 text-sm">Нет фото</div>
            <% end %>
            <div class="p-4">
              <div class="flex items-center justify-between">
                <span class="font-medium text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Номер <%= room.number %></span>
                <span class="text-indigo-600 font-medium"><%= number_to_currency(room.price_per_night, unit: "₽", precision: 0) %>/ночь</span>
              </div>
              <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                <%= room.capacity %> чел. · <%= room.size_sqm ? "#{room.size_sqm} м²" : "—" %> · этаж <%= room.floor %>
              </div>
              <% if room.approved_reviews.any? %>
                <div class="mt-2 flex items-center gap-1 text-xs text-amber-500">
                  <% 5.times do |i| %>
                    <svg class="w-3.5 h-3.5 <%= i < average_rating(room) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <% end %>
                  <span class="font-medium text-slate-600 dark:text-slate-400"><%= average_rating(room) %></span>
                </div>
              <% end %>
              <% if room.description.present? %>
                <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 line-clamp-2"><%= room.description %></p>
              <% end %>
              <span class="mt-4 inline-block w-full text-center bg-slate-900 hover:bg-slate-700 text-white text-sm font-medium py-2 rounded-lg transition-colors dark:bg-indigo-600 dark:hover:bg-indigo-500">Забронировать</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @categories.empty? %>
    <p class="text-slate-400 dark:text-slate-500 text-center py-10">Номера появятся скоро</p>
  <% end %>
</section>

<section id="services" class="bg-slate-50 dark:bg-slate-800/60 border-y border-slate-100">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-8">Услуги</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @services.each do |service| %>
        <%= link_to service_path(service), class: "group block bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all" do %>
          <div class="flex items-center justify-between">
            <h3 class="font-medium text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"><%= service.name %></h3>
            <% if service.price && service.price.positive? %>
              <span class="text-sm font-medium text-indigo-600"><%= number_to_currency(service.price, unit: "₽", precision: 0) %></span>
            <% end %>
          </div>
          <% if service.approved_reviews.any? %>
            <div class="mt-2 flex items-center gap-1 text-xs text-amber-500">
              <% 5.times do |i| %>
                <svg class="w-3.5 h-3.5 <%= i < average_rating(service) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <% end %>
              <span class="font-medium text-slate-600 dark:text-slate-400"><%= average_rating(service) %></span>
            </div>
          <% end %>
          <% if service.description.present? %>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= service.description %></p>
          <% end %>
          <span class="mt-4 inline-block w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 rounded-lg transition-colors">Заказать</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<% if @news.any? %>
  <section id="news" class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-8">Новости</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @news.each do |item| %>
        <%= link_to public_news_path(item.slug), class: "block rounded-xl border border-slate-200 dark:border-slate-700 p-6 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-sm transition-colors" do %>
          <time class="text-xs text-slate-400 dark:text-slate-500"><%= l(item.published_at, format: :long) %></time>
          <h3 class="mt-1 font-medium text-slate-900 dark:text-white"><%= item.title %></h3>
          <% if item.body.present? %>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 line-clamp-3"><%= item.body %></p>
          <% end %>
          <span class="mt-3 inline-block text-sm font-medium text-indigo-600 dark:text-indigo-400">Читать далее</span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @gallery.any? %>
  <section id="gallery" class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-8">Галерея</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% @gallery.each do |image| %>
        <%= image_tag image.image, alt: image.title, class: "w-full h-40 object-cover rounded-xl" %>
      <% end %>
    </div>
  </section>
<% end %>
