.max-w-3xl.mx-auto.px-6.py-12
  %h1.mt-6.text-3xl.font-semibold.text-slate-900.dark:text-white Новости
  - if @news.any?
    .mt-8.space-y-6
      - @news.each do |item|
        %a.block.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.hover:border-indigo-400.dark:hover:border-indigo-500.hover:shadow-sm.transition-colors{:href => news_article_path(item["slug"])}
          %time.text-xs.text-slate-400.dark:text-slate-500= l(Date.parse(item["date"]), format: :long)
          %h2.mt-1.font-medium.text-slate-900.dark:text-white= item["title"]
          - if item["body"].present?
            %p.mt-2.text-sm.text-slate-500.dark:text-slate-400.line-clamp-3= item["body"]
  - else
    .mt-8.text-center.py-16.text-slate-400.dark:text-slate-500.text-sm Новостей пока нет