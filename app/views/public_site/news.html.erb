<div class="max-w-3xl mx-auto px-6 py-12">
  <time class="text-sm text-slate-400 dark:text-slate-500"><%= l(@news.published_at, format: :long) %></time>
  <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white"><%= @news.title %></h1>

  <% if @news.body.present? %>
    <div class="mt-8 prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300">
      <%= simple_format(@news.body) %>
    </div>
  <% end %>

  <div class="mt-10">
    <%= link_to "← Назад к новостям", root_path(anchor: "news"), class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
  </div>
</div>