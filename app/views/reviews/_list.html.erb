<section id="reviews" class="mt-12">
  <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-6">Отзывы</h2>

  <% if reviewable.approved_reviews.any? %>
    <div class="space-y-4">
      <% reviewable.approved_reviews.each do |item| %>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 flex items-center justify-center text-sm font-medium">
                <%= item.user.full_name.presence&.first&.upcase || "Г" %>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white"><%= item.user.full_name.presence || item.user.email %></p>
                <p class="text-xs text-slate-400 dark:text-slate-500"><%= l(item.created_at, format: :long) %></p>
              </div>
            </div>
            <span class="flex items-center gap-0.5">
              <% 5.times do |i| %>
                <svg class="w-4 h-4 <%= i < item.rating ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <% end %>
            </span>
          </div>
          <p class="mt-3 text-slate-700 dark:text-slate-300 text-sm leading-relaxed whitespace-pre-wrap"><%= item.body %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-slate-500 dark:text-slate-400">Отзывов пока нет — станьте первым!</p>
  <% end %>

  <div id="review-form" class="mt-8">
    <% if user_signed_in? %>
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Оставить отзыв</h3>

        <%= form_with model: review, url: reviews_path, class: "space-y-4" do |form| %>
          <%= form.hidden_field :reviewable_type, value: reviewable.class.name %>
          <%= form.hidden_field :reviewable_id, value: reviewable.id %>

          <div>
            <%= form.label :rating, "Оценка", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= form.select :rating, Review::RATING_LABELS, { prompt: "Выберите оценку" },
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
          </div>

          <div>
            <%= form.label :body, "Ваш отзыв", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= form.text_area :body, rows: 4, placeholder: "Поделитесь впечатлениями…",
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
          </div>

          <%= form.submit "Отправить отзыв", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        <%= link_to "Войдите", new_user_session_path, class: "text-indigo-600 dark:text-indigo-400 font-medium" %>,
        чтобы оставить отзыв.
      </p>
    <% end %>
  </div>
</section>