<div class="max-w-4xl mx-auto px-6 py-12">
  <%= link_to "← Назад к номерам", root_path(anchor: "rooms"), class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>

  <div class="mt-6 grid lg:grid-cols-2 gap-8">
    <div data-controller="photo-gallery">
      <% if @room.photos.any? %>
        <%= image_tag @room.photos.first, data: { action: "click->photo-gallery#open", photo_gallery_index_param: 0 },
            class: "w-full h-64 object-cover rounded-xl cursor-zoom-in" %>
        <% if @room.photos.count > 1 %>
          <div class="mt-3 grid grid-cols-3 gap-2">
            <% @room.photos.drop(1).each_with_index do |photo, i| %>
              <%= image_tag photo, data: { action: "click->photo-gallery#open", photo_gallery_index_param: i + 1 },
                  class: "w-full h-20 object-cover rounded-lg border border-slate-200 dark:border-slate-700 cursor-zoom-in" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="w-full h-64 bg-slate-100 dark:bg-slate-700 rounded-xl flex items-center justify-center text-slate-300 text-sm">Нет фото</div>
      <% end %>

      <div data-photo-gallery-target="overlay"
          class="hidden fixed inset-0 z-50 bg-black/90 backdrop-blur-sm flex items-center justify-center"
          data-action="click->photo-gallery#backdropClick">
        <button data-photo-gallery-target="prevButton" data-action="click->photo-gallery#previous"
            class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors" aria-label="Предыдущее фото">←</button>

        <div class="relative w-full max-w-5xl px-20">
          <% @room.photos.each_with_index do |photo, i| %>
            <%= image_tag photo, data: { photo_gallery_target: "slide" },
                class: "#{i.zero? ? '' : 'hidden'} w-full max-h-[85vh] object-contain rounded-lg" %>
          <% end %>
        </div>

        <button data-photo-gallery-target="nextButton" data-action="click->photo-gallery#next"
            class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors" aria-label="Следующее фото">→</button>

        <button data-action="click->photo-gallery#close"
            class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-xl flex items-center justify-center transition-colors" aria-label="Закрыть">✕</button>

        <span data-photo-gallery-target="counter"
            class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-sm font-medium bg-black/50 px-3 py-1 rounded-full">1 / <%= @room.photos.count %></span>
      </div>
    </div>

    <div>
      <h1 class="text-3xl font-semibold text-slate-900 dark:text-white">Номер <%= @room.number %></h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 mt-1"><%= @room.category.name %> · <%= @room.capacity %> чел. · <%=
          @room.size_sqm ? "#{@room.size_sqm} м²" : "—" %> · этаж <%= @room.floor %></p>
      <p class="mt-4 text-2xl font-semibold text-slate-900 dark:text-white">
        <%= number_to_currency(@room.price_per_night, unit: "₽", precision: 0) %>
        <span class="text-base font-normal text-slate-500 dark:text-slate-400">/ ночь</span>
      </p>

      <div class="mt-4 flex items-center gap-2">
        <span class="inline-flex items-center gap-1 text-sm text-amber-500">
          <% 5.times do |i| %>
            <svg class="w-4 h-4 <%= i < average_rating(@room) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <% end %>
          <span class="font-medium text-slate-700 dark:text-slate-300"><%= average_rating(@room) %></span>
          <span class="text-slate-400 dark:text-slate-500">· <%= @room.approved_reviews.count %> <%= russian_pluralize(@room.approved_reviews.count, "отзыв", "отзыва", "отзывов") %></span>
        </span>
      </div>

      <% if @room.description.present? %>
        <div class="mt-5 text-slate-700 dark:text-slate-300 leading-relaxed">
          <%= simple_format(@room.description) %>
        </div>
      <% end %>

      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to "Забронировать", new_booking_path(room_id: @room.id),
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-lg transition-colors" %>
        <%= link_to "Оставить отзыв", anchor: "review-form", class: "border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium px-6 py-2.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" %>
      </div>
    </div>
  </div>

  <%= render "reviews/list", reviewable: @room, review: @review %>
</div>