<div class="max-w-4xl mx-auto px-6 py-12">
  <%= link_to "← Назад к номерам", root_path(anchor: "rooms"), class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>

  <div class="mt-6 grid lg:grid-cols-2 gap-8">
    <div>
      <% if @room.photos.any? %>
        <%= image_tag @room.photos.first, class: "w-full h-64 object-cover rounded-xl" %>
      <% else %>
        <div class="w-full h-64 bg-slate-100 dark:bg-slate-700 rounded-xl flex items-center justify-center text-slate-300 text-sm">Нет фото</div>
      <% end %>
    </div>

    <div>
      <h1 class="text-3xl font-semibold text-slate-900 dark:text-white">Номер <%= @room.number %></h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 mt-1"><%= @room.category.name %> · <%= @room.capacity %> чел. · <%=
          @room.size_sqm ? "#{@room.size_sqm} м²" : "—" %> · этаж <%= @room.floor %></p>
      <p class="mt-4 text-2xl font-semibold text-slate-900 dark:text-white">
        <%= number_to_currency(@room.price_per_night, unit: "₽", precision: 0) %>
        <span class="text-base font-normal text-slate-500 dark:text-slate-400">/ ночь</span>
      </p>

      <div class="mt-4 flex items-center gap-2">
        <span class="inline-flex items-center gap-1 text-sm text-amber-500">
          <% 5.times do |i| %>
            <svg class="w-4 h-4 <%= i < average_rating(@room) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <% end %>
          <span class="font-medium text-slate-700 dark:text-slate-300"><%= average_rating(@room) %></span>
          <span class="text-slate-400 dark:text-slate-500">· <%= @room.approved_reviews.count %> <%= russian_pluralize(@room.approved_reviews.count, "отзыв", "отзыва", "отзывов") %></span>
        </span>
      </div>

      <% if @room.description.present? %>
        <div class="mt-5 text-slate-700 dark:text-slate-300 leading-relaxed">
          <%= simple_format(@room.description) %>
        </div>
      <% end %>

      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to "Забронировать", new_booking_path(room_id: @room.id),
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-lg transition-colors" %>
        <%= link_to "Оставить отзыв", anchor: "review-form", class: "border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium px-6 py-2.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" %>
      </div>
    </div>
  </div>

  <%= render "reviews/list", reviewable: @room, review: @review %>
</div>