.max-w-4xl.mx-auto.px-6.py-12
  = link_to "← Назад к номерам", root_path(anchor: "rooms"), class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800"
  .mt-6.grid.lg:grid-cols-2.gap-8
    %div{"data-controller" => "photo-gallery"}
      - if @room.photos.any?
        = image_tag @room.photos.first, data: { action: "click->photo-gallery#open", photo_gallery_index_param: 0 }, |
          class: "w-full h-64 object-cover rounded-xl cursor-zoom-in"                                                
        - if @room.photos.count > 1
          .mt-3.grid.grid-cols-3.gap-2
            - @room.photos.drop(1).each_with_index do |photo, i|
              = image_tag image_thumb(photo, size: [ 320, 160 ]), data: { action: "click->photo-gallery#open", photo_gallery_index_param: i + 1 }, |
                class: "w-full h-20 object-cover rounded-lg border border-slate-200 dark:border-slate-700 cursor-zoom-in"                            
      - else
        .w-full.h-64.bg-slate-100.dark:bg-slate-700.rounded-xl.flex.items-center.justify-center.text-slate-300.text-sm Нет фото
      .hidden.fixed.inset-0.z-50.backdrop-blur-sm.flex.items-center.justify-center{:class => "bg-black/90", "data-action" => "click->photo-gallery#backdropClick", "data-photo-gallery-target" => "overlay"}
        %button.absolute.left-4.w-12.h-12.rounded-full.text-white.text-2xl.flex.items-center.justify-center.transition-colors{"aria-label" => "Предыдущее фото", :class => "top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20", "data-action" => "click->photo-gallery#previous", "data-photo-gallery-target" => "prevButton"} ←
        .relative.w-full.max-w-5xl.px-20
          - @room.photos.each_with_index do |photo, i|
            = image_tag photo, data: { photo_gallery_target: "slide" },                         |
              class: "#{i.zero? ? '' : 'hidden'} w-full max-h-[85vh] object-contain rounded-lg" |
        %button.absolute.right-4.w-12.h-12.rounded-full.text-white.text-2xl.flex.items-center.justify-center.transition-colors{"aria-label" => "Следующее фото", :class => "top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20", "data-action" => "click->photo-gallery#next", "data-photo-gallery-target" => "nextButton"} →
        %button.absolute.top-4.right-4.w-10.h-10.rounded-full.text-white.text-xl.flex.items-center.justify-center.transition-colors{"aria-label" => "Закрыть", :class => "bg-white/10 hover:bg-white/20", "data-action" => "click->photo-gallery#close"} ✕
        %span.absolute.bottom-6.text-white.text-sm.font-medium.px-3.py-1.rounded-full{:class => "left-1/2 -translate-x-1/2 bg-black/50", "data-photo-gallery-target" => "counter"}
          1 / #{@room.photos.count}
    %div
      %h1.text-3xl.font-semibold.text-slate-900.dark:text-white
        Номер #{@room.number}
      %p.text-lg.text-slate-500.dark:text-slate-400.mt-1
        = @room.category.name
        · #{@room.capacity} чел. · #{@room.size_sqm ? "#{@room.size_sqm} м²" : "—"} · этаж #{@room.floor}
      %p.mt-4.text-2xl.font-semibold.text-slate-900.dark:text-white
        = number_to_currency(@room.price_per_night, unit: "₽", precision: 0)
        %span.text-base.font-normal.text-slate-500.dark:text-slate-400 / ночь
      .mt-4.flex.items-center.gap-2
        %span.inline-flex.items-center.gap-1.text-sm.text-amber-500
          - 5.times do |i|
            %svg{:class => "w-4 h-4 #{i < average_rating(@room) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600'}", :viewbox => "0 0 24 24"}
              %path{:d => "M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"}
          %span.font-medium.text-slate-700.dark:text-slate-300= average_rating(@room)
          %span.text-slate-400.dark:text-slate-500
            · #{@room.approved_reviews.count} #{russian_pluralize(@room.approved_reviews.count, "отзыв", "отзыва", "отзывов")}
      - if @room.description.present?
        .mt-5.text-slate-700.dark:text-slate-300.leading-relaxed
          = simple_format(@room.description)
      - if @room.amenities.any?
        .mt-5
          %span.block.text-sm.font-medium.text-slate-500.dark:text-slate-400.mb-2 Удобства
          .flex.flex-wrap.gap-2
            - @room.amenities.each do |amenity|
              %span.inline-flex.items-center.gap-1.rounded-full.bg-indigo-50.px-3.py-1.text-sm.text-indigo-600{:class => "dark:bg-indigo-900/40 dark:text-indigo-300"}
                = amenity.name
      - if @free_window
        .mt-5.flex.items-center.gap-2.text-sm.text-slate-500.dark:text-slate-400
          %span.inline-block.h-2.w-2.rounded-full.bg-emerald-500
          Ближайшие свободные даты:
          %span.font-medium.text-slate-700.dark:text-slate-300
            = l(@free_window.first, format: :long)
            \— #{l(@free_window.last, format: :long)}
      .mt-6.rounded-xl.border.border-slate-200.dark:border-slate-700.bg-white.dark:bg-slate-800.p-5{"data-controller" => "room-availability", "data-room-availability-url-value" => available_rooms_bookings_path, "data-room-availability-room-id-value" => @room.id}
        %h3.text-sm.font-medium.text-slate-900.dark:text-white Проверить доступность
        .mt-3.flex.flex-wrap.items-center.gap-3
          %label.block
            %span.block.text-xs.text-slate-500.dark:text-slate-400.mb-1 Заезд
            %input{"data-room-availability-target" => "checkIn", :type => "date", :class => "rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-2 text-sm", :value => Date.current + 1}
          %label.block
            %span.block.text-xs.text-slate-500.dark:text-slate-400.mb-1 Выезд
            %input{"data-room-availability-target" => "checkOut", :type => "date", :class => "rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-2 text-sm", :value => Date.current + 2}
          %button{"data-action" => "click->room-availability#check", :class => "bg-slate-900 hover:bg-slate-700 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white text-sm font-medium px-4 py-2 rounded-lg"}
            Проверить
        %p.mt-3{"data-room-availability-target" => "status", :class => "text-sm text-slate-500 dark:text-slate-400"}
          Проверьте доступность
        .mt-3.hidden{"data-room-availability-target" => "alternatives"}
        .mt-3.flex.gap-3
          = link_to "Забронировать на эти даты", new_booking_path(room_id: @room.id), |
            class: "hidden bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg",
            data: { room_availability_target: "bookLink", base_url: new_booking_path(room_id: @room.id) }
          = link_to "Забронировать", new_booking_path(room_id: @room.id), |
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-lg transition-colors",
            data: { room_availability_target: "bookButton" }
      .mt-6.flex.flex-wrap.gap-3
        = link_to "Оставить отзыв", anchor: "review-form", class: "border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium px-6 py-2.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
  = render "reviews/list", reviewable: @room, review: @review
