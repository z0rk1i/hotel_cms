<div class="max-w-3xl mx-auto px-6 py-12">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-white mb-2">Заказ услуги</h1>
  <p class="text-slate-500 dark:text-slate-400 mb-8">Выберите услугу и дату — подтверждение придёт от отеля.</p>

  <% if notice.present? %>
    <div class="mb-6 rounded-lg bg-emerald-50 dark:bg-emerald-900/40 border border-emerald-200 dark:border-emerald-700/50 text-emerald-800 dark:text-emerald-200 px-4 py-3 text-sm"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-6 rounded-lg bg-red-50 dark:bg-red-900/40 border border-red-200 dark:border-red-700/50 text-red-800 dark:text-red-200 px-4 py-3 text-sm"><%= alert %></div>
  <% end %>

  <% if @service_order.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 dark:bg-red-900/40 border border-red-200 dark:border-red-700/50 text-red-800 dark:text-red-200 px-4 py-3 text-sm">
      <strong><%= pluralize(@service_order.errors.count, "ошибка") %>:</strong> <%= @service_order.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with model: @service_order, class: "space-y-6" do |form| %>
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 space-y-4">
      <div>
        <%= form.label :service_id, "Услуга", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.collection_select :service_id, @services, :id, :name,
            { include_blank: "Выберите услугу" },
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :service_date, "Дата", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
          <%= form.date_field :service_date, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
        </div>
        <div>
          <%= form.label :quantity, "Количество", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
          <%= form.number_field :quantity, min: 1, value: @service_order.quantity, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
        </div>
      </div>

      <div>
        <%= form.label :notes, "Пожелания", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.text_area :notes, rows: 3, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit "Заказать услугу", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg" %>
      <%= link_to "Отмена", account_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2" %>
    </div>
  <% end %>
</div>