.max-w-3xl.mx-auto.px-6.py-12
  %h1.text-2xl.font-semibold.text-slate-900.dark:text-white.mb-2 Заказ услуги
  %p.text-slate-500.dark:text-slate-400.mb-8 Выберите услугу и дату — подтверждение придёт от отеля.
  - if notice.present?
    .mb-6.rounded-lg.bg-emerald-50.border.border-emerald-200.text-emerald-800.dark:text-emerald-200.px-4.py-3.text-sm{:class => "dark:bg-emerald-900/40 dark:border-emerald-700/50"}= notice
  - if alert.present?
    .mb-6.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}= alert
  - if @bookings.none?
    .mb-6.rounded-xl.bg-amber-50.border.border-amber-200.text-amber-800.dark:text-amber-200.p-6{:class => "dark:bg-amber-900/40 dark:border-amber-700/50"}
      %p.font-medium Заказ услуг доступен только при активной брони
      %p.mt-1.text-sm Забронируйте номер, и после подтверждения вы сможете заказывать услуги.
      = link_to "Забронировать номер", new_booking_path, class: "mt-4 inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
      %p.mt-4.text-sm.text-amber-700.dark:text-amber-300
        Есть бронь? Проверьте её статус в
        = link_to "личном кабинете", account_path, class: "underline"
        \.
  - else
    = form_with model: @service_order, class: "space-y-6" do |form|
      - if @service_order.errors.any?
        .mb-6.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}
          %strong
            = pluralize(@service_order.errors.count, "ошибка")
            \:
          = @service_order.errors.full_messages.to_sentence
      .bg-white.dark:bg-slate-800.rounded-xl.border.border-slate-200.dark:border-slate-700.p-6.space-y-4
        %div
          = form.label :booking_id, "Бронирование", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
          = form.collection_select :booking_id, @bookings, :id, :booking_option_label,                                  |
            { include_blank: "Выберите бронь" },                                                                         |
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" 
        %div
          = form.label :service_id, "Услуга", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
          = form.collection_select :service_id, @services, :id, :name,                                                                                |
            { include_blank: "Выберите услугу" },                                                                                                     |
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600" 
        .grid.grid-cols-2.gap-4
          %div
            = form.label :service_date, "Дата", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
            = form.date_field :service_date, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600"
          %div
            = form.label :quantity, "Количество", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
            = form.number_field :quantity, min: 1, value: @service_order.quantity, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600"
        %div
          = form.label :notes, "Пожелания", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
          = form.text_area :notes, rows: 3, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-slate-100 dark:border-slate-600"
      .flex.items-center.gap-3
        = form.submit "Заказать услугу", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2 rounded-lg"
        = link_to "Отмена", account_path, class: "text-sm text-slate-600 dark:text-slate-300 hover:text-slate-800 px-3 py-2"
