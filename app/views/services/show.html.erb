<div class="max-w-4xl mx-auto px-6 py-12">
  <%= link_to "← Назад к услугам", root_path(anchor: "services"), class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>

  <div class="mt-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-8">
    <h1 class="text-3xl font-semibold text-slate-900 dark:text-white"><%= @service.name %></h1>

    <div class="mt-3 flex items-center gap-2">
      <span class="inline-flex items-center gap-1 text-sm text-amber-500">
        <% 5.times do |i| %>
          <svg class="w-4 h-4 <%= i < average_rating(@service) ? 'fill-amber-400' : 'fill-slate-200 dark:fill-slate-600' %>" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <% end %>
        <span class="font-medium text-slate-700 dark:text-slate-300"><%= average_rating(@service) %></span>
        <span class="text-slate-400 dark:text-slate-500">· <%= @service.approved_reviews.count %> <%= russian_pluralize(@service.approved_reviews.count, "отзыв", "отзыва", "отзывов") %></span>
      </span>
    </div>

    <% if @service.price && @service.price.positive? %>
      <p class="mt-4 text-2xl font-semibold text-slate-900 dark:text-white"><%= number_to_currency(@service.price, unit: "₽", precision: 0) %></p>
    <% end %>

    <% if @service.description.present? %>
      <div class="mt-4 text-slate-700 dark:text-slate-300 leading-relaxed">
        <%= simple_format(@service.description) %>
      </div>
    <% end %>

    <div class="mt-6">
      <% if user_signed_in? %>
        <%= link_to "Заказать", new_service_order_path(service_id: @service.id),
            class: "inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-lg transition-colors" %>
      <% else %>
        <%= link_to "Заказать", new_service_order_path(service_id: @service.id),
            class: "inline-block border border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-medium px-6 py-2.5 rounded-lg transition-colors dark:text-indigo-400 dark:hover:bg-indigo-900/30" %>
      <% end %>
      <%= link_to "Оставить отзыв", anchor: "review-form", class: "inline-block border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium px-6 py-2.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" %>
    </div>
  </div>

  <%= render "reviews/list", reviewable: @service, review: @review %>
</div>