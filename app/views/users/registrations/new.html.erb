<div class="min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950 px-4 py-10">
  <div class="w-full max-w-sm">
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-8">
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-white text-center">Регистрация</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 text-center mt-1 mb-6">Личный кабинет гостя</p>

      <% if alert.present? %>
        <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/40 border border-red-200 dark:border-red-700/50 text-red-800 dark:text-red-200 px-4 py-3 text-sm"><%= alert %></div>
      <% end %>

      <div class="space-y-3 mb-6">
        <%= button_to user_vkontakte_omniauth_authorize_path, data: { turbo: false }, class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-[#0077FF] hover:bg-[#0064d8] text-white text-sm font-medium transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 2.073-5.336h-3.204c-.54 0-.787.131-.985.548-.359.759-1.39 2.029-1.879 2.464-.25.222-.544.144-.764-.088-.927-.961-1.94-2.924-2.487-2.924-.335 0-.539.221-.775.479l-1.169 1.489c-.735.973-.554 2.038-.215 2.823.635 1.474 1.945 2.707 1.945 2.707s-2.318 3.031-2.852 4.288c-.214.504.035.706.537.706z"/></svg>
          Зарегистрироваться через VK
        <% end %>
        <%= button_to user_yandex_omniauth_authorize_path, data: { turbo: false }, class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-[#FC3F1D] hover:bg-[#d93516] text-white text-sm font-medium transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1C5.925 1 1 5.925 1 12s4.925 11 11 11 11-4.925 11-11S18.075 1 12 1zm3.5 17h-2.154l-1.496-4.368L10.31 18H8.155l2.587-6.908c.434-1.16.942-1.684 1.524-1.684.584 0 1.09.526 1.518 1.576L16.5 18z"/></svg>
          Зарегистрироваться через Яндекс
        <% end %>
      </div>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200 dark:border-slate-700"></div></div>
        <div class="relative flex justify-center"><span class="bg-white dark:bg-slate-800 px-3 text-xs text-slate-400 dark:text-slate-500">или по email</span></div>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <%= render "users/shared/error_messages", resource: resource %>

          <div>
            <%= f.label :full_name, "ФИО", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.text_field :full_name, autofocus: true, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-500 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
          </div>
          <div>
            <%= f.label :phone, "Телефон", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.text_field :phone, class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-500 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
          </div>
          <div>
            <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-500 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
          </div>
          <div>
            <%= f.label :password, "Пароль", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <% if @minimum_password_length %>
              <em class="text-xs text-slate-400">(<%= @minimum_password_length %> символов минимум)</em>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-500 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Подтверждение пароля", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-500 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" %>
          </div>
          <%= f.submit "Зарегистрироваться", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg transition-colors" %>
        </div>
      <% end %>

      <p class="mt-6 text-sm text-center text-slate-500 dark:text-slate-400">
        Уже есть аккаунт? <%= link_to "Войти", new_user_session_path, class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 font-medium" %>
      </p>
    </div>
  </div>
</div>
