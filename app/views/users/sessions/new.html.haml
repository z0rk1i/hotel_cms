.min-h-screen.flex.items-center.justify-center.bg-slate-100.dark:bg-slate-900.px-4.relative
  %button.absolute.top-5.right-5.inline-flex.items-center.justify-center.w-9.h-9.rounded-lg.bg-white.dark:bg-slate-800.border.border-slate-200.dark:border-slate-700.text-slate-600.dark:text-slate-300.hover:bg-slate-50.dark:hover:bg-slate-700.transition-colors{"aria-label" => "Переключить тему", "data-action" => "click->theme#toggle", "data-controller" => "theme", "data-theme-target" => "icon", :type => "button"}
    = render "shared/theme_icon"
  .w-full.max-w-sm
    .bg-white.dark:bg-slate-800.rounded-2xl.border.border-slate-200.dark:border-slate-700.shadow-sm.p-8
      %h1.text-2xl.font-semibold.text-slate-900.dark:text-white.text-center Hotel CMS
      %p.text-sm.text-slate-500.dark:text-slate-400.text-center.mt-1.mb-8 Вход в панель управления
      - if alert.present?
        .mb-4.rounded-lg.bg-red-50.border.border-red-200.text-red-800.dark:text-red-200.px-4.py-3.text-sm{:class => "dark:bg-red-900/40 dark:border-red-700/50"}
          = alert
      = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
        .space-y-4
          %div
            = f.label :email, "Email", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
            = f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-400 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
          %div
            = f.label :password, "Пароль", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1"
            = f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 dark:text-slate-100 dark:placeholder-slate-400 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
          - if devise_mapping.rememberable?
            .flex.items-center.gap-2
              = f.check_box :remember_me, class: "rounded border-slate-300 dark:border-slate-600 dark:bg-slate-900"
              = f.label :remember_me, "Запомнить меня", class: "text-sm text-slate-600 dark:text-slate-300"
          = f.submit "Войти", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg mt-2 transition-colors"